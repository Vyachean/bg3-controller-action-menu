                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding IsSelectingUpcastedSpell}" Value="True">
                    <ls:SetMoveFocusAction TargetName="ActionRadials" FocusElement="{Binding ElementName=SingleBar}"/>
                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding IsShowingItemsToThrow}" Value="True">
                    <ls:SetMoveFocusAction TargetName="ActionRadials" FocusElement="{Binding ElementName=SingleBar}"/>
                </b:DataTrigger>
