<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ls="clr-namespace:ls;assembly=Code"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">

    <!-- Literal value from Patch 8 HotBar.xaml: <Thickness x:Key="ResourceBackgroundMargin">0</Thickness>.
         The CAM alias is local because the keyboard page's ResourceDictionary is not
         the controller library's resource scope. Do not reference an undeclared alias. -->
    <Thickness x:Key="CAM_ResourceBackgroundMargin">0</Thickness>
    <!-- CAM owns composition only. Each focused/executed action remains a native VMHotBarSlot. -->
    <System:Double x:Key="CAM_ActionGridCellSize">120</System:Double>
    <!-- Exact Patch 8 keyboard HotBar Action Resources presentation, captured from
         Mods/MainUI/GUI/Pages/HotBar.xaml in Xbox App 1.8.910.0. -->
    <BitmapImage x:Key="CAM_BarResources"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/bar_resources.png"/>
    <BitmapImage x:Key="CAM_BoxResourceBg"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resource_empty.png"/>
    <BitmapImage x:Key="CAM_BoxResource"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resource_d.png"/>
    <BitmapImage x:Key="CAM_BoxResourceH"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resource_h.png"/>
    <BitmapImage x:Key="CAM_BoxResourceDisabled"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resource_missing.png"/>
    <BitmapImage x:Key="CAM_BoxResourceNumBg"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resourceNum_empty.png"/>
    <BitmapImage x:Key="CAM_BoxResourceNum"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resourceNum_d.png"/>
    <BitmapImage x:Key="CAM_BoxResourceNumH"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resourceNum_h.png"/>
    <BitmapImage x:Key="CAM_BoxResourceNumDisabled"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resourceNum_missing.png"/>
    <BitmapImage x:Key="CAM_ItemsProviderIcon"
                 UriSource="pack://application:,,,/Core;component/Assets/Shared/ico_container_more_d.png"/>
    <BitmapImage x:Key="CAM_AllProviderIcon"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/Shared/ico_tab_all.png"/>
    <System:String x:Key="CAM_ResetFirstFocusToken">CAM_ResetFirstFocus</System:String>
    <System:String x:Key="CAM_NestedEnteredToken">CAM_NestedEntered</System:String>
    <System:String x:Key="CAM_NestedRestoringToken">CAM_NestedRestoring</System:String>
    <System:String x:Key="CAM_TabCycleRightToken">CAM_TabCycleRight</System:String>
    <System:String x:Key="CAM_TabCycleLeftToken">CAM_TabCycleLeft</System:String>
    <System:String x:Key="CAM_TabEnterPassivesToken">CAM_TabEnterPassives</System:String>
    <System:String x:Key="CAM_TabReturnFirstToken">CAM_TabReturnFirst</System:String>
    <System:String x:Key="CAM_TabReturnLastToken">CAM_TabReturnLast</System:String>
    <System:String x:Key="CAM_TabEnterSpecialToken">CAM_TabEnterSpecial</System:String>
    <System:String x:Key="CAM_CantripsModeToken">CAM_CantripsMode</System:String>
    <System:String x:Key="CAM_ItemsModeToken">CAM_ItemsMode</System:String>
    <System:String x:Key="CAM_AllModeToken">CAM_AllMode</System:String>
    <System:String x:Key="CAM_MetamagicModeToken">CAM_MetamagicMode</System:String>
    <System:String x:Key="CAM_PassivesModeToken">CAM_PassivesMode</System:String>
    <System:String x:Key="CAM_CantripFilterParameter">h7d02199dg44ecg4a1egbcacg9cc1cec197b3</System:String>

    <!-- Original PreloadedActionRadials_c.xaml:22,32-53.
         Namespaced to CAM because this is an independent controller library. -->
    <ImageSource x:Key="CAM_NotificationBg">pack://application:,,,/Core;component/Assets/Notification/smallNotice_bg.png</ImageSource>
    <Storyboard x:Key="CAM_FadeInNotification" FillBehavior="Stop">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Storyboard.TargetName="CAM_ControlNotifications">
            <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1"/>
            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1"/>
            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CAM_ControlNotifications" Storyboard.TargetProperty="Visibility">
            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
            <DiscreteObjectKeyFrame KeyTime="0:0:1.5" Value="{x:Static Visibility.Collapsed}"/>
        </ObjectAnimationUsingKeyFrames>
    </Storyboard>
    <Style x:Key="CAM_NotificationBG9Slice"
           TargetType="ls:LSNineSliceImage"
           BasedOn="{StaticResource {x:Type ls:LSNineSliceImage}}">
        <Setter Property="ImageSource" Value="{StaticResource CAM_NotificationBg}"/>
        <Setter Property="Slices" Value="24"/>
        <Setter Property="MinWidth" Value="152"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="20,12,20,12"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style x:Key="CAM_ActionGridSlotContainer"
           TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="ls:MoveFocus.Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="104"/>
        <Setter Property="Height" Value="104"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Tag" Value="{Binding .}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Width="104" Height="104" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <b:Interaction.Triggers>
                            <b:DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True">
                                <b:Interaction.Behaviors>
                                    <b:ConditionBehavior>
                                        <b:ConditionalExpression>
                                            <b:ComparisonCondition LeftOperand="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ls:LSListBox}}}"
                                                                   Operator="Equal"
                                                                   RightOperand="{StaticResource CAM_ResetFirstFocusToken}"/>
                                        </b:ConditionalExpression>
                                    </b:ConditionBehavior>
                                </b:Interaction.Behaviors>
                                <ls:SetMoveFocusAction TargetName="ActionRadials"
                                                       FocusElement="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                       DeferFocusAction="True"/>
                                <b:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ls:LSListBox}}}"
                                                        PropertyName="Tag"
                                                        Value="{x:Null}"/>
                            </b:DataTrigger>
                        </b:Interaction.Triggers>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SlotType}" Value="Empty">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Focusable" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CAM_ActionGridSlotTemplate">
        <!-- VMHotBarSlot remains the focus/dispatch object. Non-items keep the proven 104x104
             assignment icon surface; item slots delegate presentation to the same VMItem templates
             used by the Patch 8 keyboard HotBar/inventory so Count and item chrome stay native. -->
        <Grid Width="104" Height="104" Background="Transparent">
            <Rectangle x:Name="GenericIcon"
                       Fill="{Binding Content.Icon}"
                       Width="104"
                       Height="104"/>
            <ContentPresenter x:Name="ItemPresenter"
                              Content="{Binding Content}"
                              ContentTemplate="{StaticResource Template.Item}"
                              Width="104"
                              Height="104"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="Collapsed"/>
            <Rectangle x:Name="DisabledOverlay"
                       Width="104"
                       Height="104"
                       Fill="#88000000"
                       Visibility="Collapsed"/>
            <!-- Native controller radial dims incompatible spells while the
                 character has active metamagic. This is purely presentation:
                 BG3 owns MetamagicActive and Content.IsModified. -->
            <Rectangle x:Name="CAM_MetamagicIncompatibleOverlay"
                       Width="104"
                       Height="104"
                       Fill="#88000000"
                       Opacity="0.2"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
            <Image x:Name="SubSelectIndicator"
                   Source="{StaticResource IcoPlusImg}"
                   Stretch="None"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,8,8,0"
                   Visibility="Collapsed"/>
            <!-- Native Patch 8 templates consume the game's VMHotBarSlot state.
                 No CAM spell compatibility or metamagic cost classification. -->
            <Control x:Name="CAM_ModifiedSpellGlow"
                     Width="104" Height="104"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False" Focusable="False"
                     Visibility="Collapsed"
                     Template="{StaticResource HotbarSlotGlow}"/>
            <Control x:Name="CAM_ActiveMetamagicGlow"
                     Width="104" Height="104"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False" Focusable="False"
                     Visibility="Collapsed"
                     Template="{StaticResource HotBarActiveSlotIndicatorMetamagic}"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding SlotType}" Value="Item">
                <Setter TargetName="GenericIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ItemPresenter" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.IsEquipment}" Value="True">
                <Setter TargetName="ItemPresenter" Property="ContentTemplate" Value="{StaticResource Template.ItemEquipment}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.IsContainer}" Value="True">
                <Setter TargetName="ItemPresenter" Property="ContentTemplate" Value="{StaticResource Template.ItemContainer}"/>
                <Setter TargetName="SubSelectIndicator" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CanUse}" Value="False">
                <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.IsModified}" Value="True">
                <Setter TargetName="CAM_ModifiedSpellGlow" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <!-- The current installed Patch 8 radial uses the native
                 MetamagicActive + !IsModified condition to dim incompatible
                 spell slots. Never infer compatibility from action names or
                 resources, and do not dim item/passive slots. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding SlotType}" Value="Spell"/>
                    <Condition Binding="{Binding Content.IsModified}" Value="False"/>
                    <Condition Binding="{Binding DataContext.CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.MetamagicActive, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CAM_MetamagicIncompatibleOverlay" Property="Visibility" Value="Visible"/>
                <Setter TargetName="GenericIcon" Property="Opacity" Value="0.7"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Content.IsMetaMagic}" Value="True"/>
                    <Condition Binding="{Binding IsActive}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CAM_ActiveMetamagicGlow" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="CAM_ActionGridPanel">
        <ls:LSGrid ActionUpEvent="UIUp"
                   ActionDownEvent="UIDown"
                   ActionRightEvent="UIRight"
                   ActionLeftEvent="UILeft"
                   AutoIndex="True"
                   ContainerData="{Binding}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   CellWidth="{StaticResource CAM_ActionGridCellSize}"
                   CellHeight="{StaticResource CAM_ActionGridCellSize}"
                   EmptyCellTemplate="{DynamicResource EmptyCellTemplate}">
            <ls:LSGrid.Columns>
                <MultiBinding Converter="{StaticResource DivideMultiConverter}" ConverterParameter="Floor">
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type ScrollContentPresenter}}"/>
                    <Binding Source="{StaticResource CAM_ActionGridCellSize}"/>
                </MultiBinding>
            </ls:LSGrid.Columns>
        </ls:LSGrid>
    </ItemsPanelTemplate>

    <!-- Native radial assignment proves one outer LSListBox can own LocalFocus across
         nested LSListBox groups. CAM uses the same shape for the KeyboardHotBars fallback,
         but every executable child remains a VMHotBarSlot from VMHotBar.SlotList. -->
    <ItemsPanelTemplate x:Key="CAM_AllGroupsPanel">
        <ls:LSVirtualizingStackPanel/>
    </ItemsPanelTemplate>

    <Style x:Key="CAM_AllGroupContainerStyle"
           TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ls:MoveFocus.Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SlotList.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CAM_AllGroupTemplate"
                  DataType="ls:VMHotBar">
        <ls:LSListBox x:Name="CAM_AllGroupSlots"
                      ItemsSource="{Binding SlotList}"
                      Focusable="False"
                      ActionNextEvent="UIDown"
                      ActionPrevEvent="UIUp"
                      KeyboardNavigation.DirectionalNavigation="Continue"
                      HorizontalAlignment="Stretch"
                      Template="{StaticResource ScrolllessListBox}"
                      ItemContainerStyle="{StaticResource CAM_ActionGridSlotContainer}"
                      ItemTemplate="{StaticResource CAM_ActionGridSlotTemplate}"
                      ItemsPanel="{StaticResource CAM_ActionGridPanel}">
            <b:Interaction.Triggers>
                <!-- The outer group selection is the native radial-style handoff boundary.
                     Arm the existing concrete-slot focus token on the selected inner list,
                     then select its first VMHotBarSlot. -->
                <b:PropertyChangedTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                       Operator="Equal"
                                                       RightOperand="True"/>
                                <b:ComparisonCondition LeftOperand="{Binding SlotList.Count}"
                                                       Operator="GreaterThan"
                                                       RightOperand="0"/>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_AllModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="Tag"
                                            Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="SelectedIndex"
                                            Value="-1"/>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="SelectedIndex"
                                            Value="0"/>
                </b:PropertyChangedTrigger>
                <b:EventTrigger EventName="Loaded">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                       Operator="Equal"
                                                       RightOperand="True"/>
                                <b:ComparisonCondition LeftOperand="{Binding SlotList.Count}"
                                                       Operator="GreaterThan"
                                                       RightOperand="0"/>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_AllModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="Tag"
                                            Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="SelectedIndex"
                                            Value="-1"/>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="SelectedIndex"
                                            Value="0"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </ls:LSListBox>
    </DataTemplate>

    <!-- Resource group templates are resolved locally from the literal installed
         Patch 8 keyboard DataTemplates_k.xaml definitions below. The native
         shared ActionResources.ActionGroup.ActionPoint DataTemplate and game
         ActionResourcesTemplateSelector retain all point state animations. -->
    <!-- Controller selection is transport only. Native resource content is the current Patch 8
         ActionResourcesList item template; ListBoxItem.IsSelected must not alter its visuals. -->
    <Style x:Key="CAM_ResourceTabItemStyle"
           TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="-4,0,-4,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <b:Interaction.Triggers>
                            <b:DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True">
                                <b:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ls:LSListBox}}}"
                                                        PropertyName="Tag"
                                                        Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                            </b:DataTrigger>
                        </b:Interaction.Triggers>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActionResource}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActionResource.MaxValue}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CAM_ResourceTabTemplate"
                  DataType="ls:VMActionResourceCostPreview">
        <ls:LSButton Padding="0"
                     Margin="4,-10,4,10"
                     Focusable="False"
                     ls:MoveFocus.Focusable="False">
            <ls:AttachedProperties.AutomationId>
                <MultiBinding StringFormat="{}{0}_{1}">
                    <Binding Path="ActionResource.TypeId"/>
                    <Binding Path="ActionResource.Value"/>
                </MultiBinding>
            </ls:AttachedProperties.AutomationId>

            <Grid x:Name="Root" Width="72">
                <!-- The controller scope loads DataTemplates_c.xaml (80/80/36);
                     the keyboard HotBar's DataTemplates_k.xaml declares 56/48/24.
                     Scope these original keyboard values to this resource item
                     so DynamicResource in the native selector resolves correctly
                     without changing global controller UI resource dictionaries. -->
                <Grid.Resources>
                    <!-- Pixel-for-pixel source XAML from keyboard Patch 8 DataTemplates_k.xaml,
                         groups only; scoped to CAM resource previews so the rest of
                         BG3's controller UI retains its own DataTemplates_c.xaml. -->
                    <System:Double x:Key="ActionResources.ActionPointGroupSize">56</System:Double>
                    <System:Double x:Key="ActionResources.ActionPointSize">48</System:Double>
                    <System:Double x:Key="ActionResources.ActionPointSmallSize">24</System:Double>


                    <!-- The original keyboard DefaultTheme.Styles.xaml declares
                         these strings; controller DefaultTheme_c.Styles.xaml instead
                         points to Assets/ActionResources_c/Icons/Resources/.
                         Keep this scope within the CAM resource-item Grid. -->
                    <System:String x:Key="ActionResourcePointIconsPath">Assets/Shared/Resources/</System:String>
                    <System:String x:Key="ActionResourcePointHighlightIconsPath">Assets/Shared/Resources/Highlight/</System:String>
                    <System:String x:Key="ActionResourcePointMissingIconsPath">Assets/Shared/Resources/Missing/</System:String>
                    <System:String x:Key="ActionResourcePointUsedIconsPath">Assets/Shared/Resources/Used/</System:String>

                    <!-- Installed 1.8.910.0 DataTemplates.xaml native point
                         DataTemplate, unchanged. It must be locally declared
                         after the four keyboard paths: the globally-defined
                         template resolves controller StaticResource paths. -->
    <DataTemplate x:Key="ActionResources.ActionGroup.ActionPoint">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="image" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.Source>
                    <MultiBinding Converter="{StaticResource IconIdToSourceConverter}" FallbackValue="{StaticResource TypeIdToSourceFallback}">
                        <Binding Source="{StaticResource ActionResourcePointIconsPath}"/>
                        <Binding Path="DataContext.TypeId" RelativeSource="{RelativeSource AncestorType=ls:LSActionPointResources}"/>
                    </MultiBinding>
                </Image.Source>
                <Image.RenderTransform>
                    <TransformGroup>
                        <SkewTransform/>
                        <ScaleTransform CenterX="22" CenterY="32"/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="imageExplosion" Stretch="None" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.Source>
                    <MultiBinding Converter="{StaticResource IconIdToSourceConverter}" FallbackValue="{StaticResource TypeIdToSourceFallback}">
                        <Binding Source="{StaticResource ActionResourcePointHighlightIconsPath}"/>
                        <Binding Path="DataContext.TypeId" RelativeSource="{RelativeSource AncestorType=ls:LSActionPointResources}"/>
                    </MultiBinding>
                </Image.Source>
                <Image.RenderTransform>
                    <TransformGroup>
                        <SkewTransform/>
                        <ScaleTransform CenterX="22" CenterY="32"/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=ActionPointState, RelativeSource={RelativeSource AncestorType=ls:LSActionPoint}}" Value="Highlight">
                <Setter TargetName="image" Property="Source">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource IconIdToSourceConverter}" FallbackValue="{StaticResource DefaultHighlightTypeIdFallback}">
                            <Binding Source="{StaticResource ActionResourcePointHighlightIconsPath}"/>
                            <Binding Path="DataContext.TypeId" RelativeSource="{RelativeSource AncestorType=ls:LSActionPointResources}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=ActionPointState, RelativeSource={RelativeSource AncestorType=ls:LSActionPoint}}" Value="Missing">
                <Setter TargetName="image" Property="Source">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource IconIdToSourceConverter}" FallbackValue="{StaticResource DefaultMissingTypeIdFallback}">
                            <Binding Source="{StaticResource ActionResourcePointMissingIconsPath}"/>
                            <Binding Path="DataContext.TypeId" RelativeSource="{RelativeSource AncestorType=ls:LSActionPointResources}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=ActionPointState, RelativeSource={RelativeSource AncestorType=ls:LSActionPoint}}" Value="Used">
                <Setter TargetName="image" Property="Source">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource IconIdToSourceConverter}" FallbackValue="{StaticResource DefaultUsedTypeIdFallback}">
                            <Binding Source="{StaticResource ActionResourcePointUsedIconsPath}"/>
                            <Binding Path="DataContext.TypeId" RelativeSource="{RelativeSource AncestorType=ls:LSActionPointResources}"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding (ls:AttachedProperties.InheritedTag), RelativeSource={RelativeSource Mode=Self}}" Value="NoAnimation">
                <Setter TargetName="imageExplosion" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=ActionPointState, RelativeSource={RelativeSource AncestorType=ls:LSActionPoint}}" Value="Used"/>
                    <Condition Binding="{Binding Path=IsActionPointSpent, RelativeSource={RelativeSource AncestorType=ls:LSActionPoint}}" Value="True"/>
                    <Condition Binding="{Binding Path=Visibility, ElementName=imageExplosion}" Value="Visible"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="explodeAnim">
                        <Storyboard RepeatBehavior="1x">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="imageExplosion" Storyboard.TargetProperty="(Image.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)">
                                <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.6"/>
                                <DiscreteDoubleKeyFrame Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="imageExplosion" Storyboard.TargetProperty="(Image.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)">
