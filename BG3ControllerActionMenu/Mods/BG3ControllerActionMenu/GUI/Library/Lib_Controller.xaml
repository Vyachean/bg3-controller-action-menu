                    <!-- One row-level clip prevents selector chrome from reaching tabs
                         without cutting the native ring at the sidebar/main boundary.
                         The 16px top/bottom focus clearance fits inside the same
                         850px catalog row; cell geometry remains 104-in-120. -->
                    <Grid x:Name="CAM_ActionRowClip"
                          Grid.Row="2"
                          Grid.ColumnSpan="2"
                          ClipToBounds="True"
                          Height="850">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    <!-- Keyboard HotBar.xaml shows FixedSideBar alongside the main deck.
                         Preserve native VMHotBarSlot values, source order and count. -->
                    <!-- Patch 8 SelectorTemplate uses Margin=-12; the cell's
                         104px icon inset is 8px within a 120px cell. The
                         12px sidebar left gutter keeps the complete native
                         ring within CAM_ActionRowClip and moves both native
                         list and selector together, preserving their shared
                         coordinate root. -->
                    <Grid x:Name="CAM_FixedSideBarRegion"
                          Grid.Row="0"
                          Grid.Column="0"
                          Width="128"
                          Height="818"
                          Margin="12,16,0,16"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Visibility="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.FixedSideBar.SlotList.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ls:LSListBox x:Name="CAM_FixedSideBarList"
                                      Width="120"
                                      Height="818"
                                      HorizontalAlignment="Left"
                                      SelectedIndex="-1"
                                      Background="Transparent"
                                      ItemsSource="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.FixedSideBar.SlotList}"
                                      ItemContainerStyle="{StaticResource CAM_ActionGridSlotContainer}"
                                      ItemTemplate="{StaticResource CAM_ActionGridSlotTemplate}"
                                      ItemsPanel="{StaticResource CAM_FixedSideBarPanel}"
                                      KeyboardNavigation.DirectionalNavigation="Contained"
                                      ActionNextEvent="UIDown"
                                      ActionPrevEvent="UIUp"
                                      LocalFocusSelector="{Binding ElementName=CAM_FixedSideBarSelector,Mode=OneWay}">
                            <!-- FixedSideBar stays visible in all tabs, but it may only
                                 receive input while its explicit LB/RB mode owns focus.
                                 Native nested state temporarily returns focus to HotBarList. -->
                            <ls:LSListBox.Style>
                                <Style TargetType="{x:Type ls:LSListBox}" BasedOn="{StaticResource {x:Type ls:LSListBox}}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_MetamagicModeToken}"/>
                                                <Condition Binding="{Binding IsShowingAContainerWithVariants}" Value="False"/>
                                                <Condition Binding="{Binding IsSelectingUpcastedSpell}" Value="False"/>
                                                <Condition Binding="{Binding IsShowingItemsToThrow}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </MultiDataTrigger>
                                        <!-- Native summon overlay replaces the ordinary
                                             keyboard deck. Never let both sidebar and
                                             summoned slot grid own focus/UseSlotCommand. -->
                                        <DataTrigger Binding="{Binding SummonHotBar.SlotList.Count, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ls:LSListBox.Style>
                            <ls:LSListBox.Template>
                                <ControlTemplate TargetType="{x:Type ListBox}">
                                    <ls:LSScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                       VerticalScrollBarVisibility="Auto"
                                                       CanContentScroll="False"
                                                       ls:LSScrollViewer.ScrollToElement="{Binding FocusedElement, ElementName=ActionRadials}">
                                        <ItemsPresenter/>
                                    </ls:LSScrollViewer>
                                </ControlTemplate>
                            </ls:LSListBox.Template>
                            <ls:LSListBox.ToolTip>
                                <ls:LSTooltip x:Name="CAM_FixedSideBarTooltip"
                                              ToolTipService.Placement="Right"
                                              ToolTipService.HorizontalOffset="40"
                                              ToolTipService.VerticalOffset="-40"
                                              ls:TooltipExtender.Context="Hotbar"/>
                            </ls:LSListBox.ToolTip>
                            <b:Interaction.Triggers>
                                <!-- Focus events must never change CAM_ProviderModeMarker:
                                     LB/RB is the sole source of provider transitions. -->
                                <b:EventTrigger EventName="LocalFocusChanged">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding IsEnabled, ElementName=CAM_FixedSideBarList}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding LocalFocus.DataContext, ElementName=CAM_FixedSideBarList, Converter={StaticResource NullToBoolFalseConverter}}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <!-- The same ActionRadials.Tag -> UseSlotCommand route
                                         used by the main grid must own the side selection. -->
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarTooltip"
                                                            PropertyName="Content"
                                                            Value="{Binding LocalFocus.DataContext.Content, ElementName=CAM_FixedSideBarList}"/>
                                    <b:InvokeCommandAction IsEnabled="{Binding LocalFocus.DataContext.Content, ElementName=CAM_FixedSideBarList, Converter={StaticResource NullToBoolFalseConverter}}"
                                                           Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding ., ElementName=CAM_FixedSideBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.ClearResourceHighlightsCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_SlotHover"/>
                                </b:EventTrigger>
                                <b:TimerTrigger EventName="LocalFocusChanged" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior><b:ConditionalExpression>
                                            <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                                   Operator="Equal" RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                                            <b:ComparisonCondition LeftOperand="{Binding IsEnabled, ElementName=CAM_FixedSideBarList}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                            <b:ComparisonCondition LeftOperand="{Binding LocalFocus.DataContext, ElementName=CAM_FixedSideBarList, Converter={StaticResource NullToBoolFalseConverter}}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                        </b:ConditionalExpression></b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials"
                                                            PropertyName="Tag"
                                                            Value="{Binding LocalFocus.DataContext, ElementName=CAM_FixedSideBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=CAM_FixedSideBarList}"/>
                                </b:TimerTrigger>
                                <!-- Sidebar selection is programmatic at LB/RB entry. The
                                     selector can be visible with a stable LocalFocus,
                                     so LocalFocusChanged alone need not fire. Mirror
                                     the proven main-list SelectionChanged wake seam. -->
                                <b:TimerTrigger EventName="SelectionChanged" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                               Operator="Equal" RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding IsEnabled, ElementName=CAM_FixedSideBarList}"
                                                               Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding LocalFocus.DataContext, ElementName=CAM_FixedSideBarList}"
                                                               Operator="NotEqual" RightOperand="{x:Null}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarTooltip"
                                                            PropertyName="Content"
                                                            Value="{Binding LocalFocus.DataContext.Content, ElementName=CAM_FixedSideBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding ., ElementName=CAM_FixedSideBarList}"/>
                                    <b:ChangePropertyAction TargetName="ActionRadials"
                                                            PropertyName="Tag"
                                                            Value="{Binding LocalFocus.DataContext, ElementName=CAM_FixedSideBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=CAM_FixedSideBarList}"/>
                                </b:TimerTrigger>
                            </b:Interaction.Triggers>
                        </ls:LSListBox>
                        <Control x:Name="CAM_FixedSideBarSelector"
                                 IsHitTestVisible="False"
                                 Focusable="False"
                                 Panel.ZIndex="2"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Template="{StaticResource SelectorTemplate}">
                            <Control.Style>
                                <Style TargetType="Control">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_MetamagicModeToken}"/>
                                                <Condition Binding="{Binding IsShowingAContainerWithVariants}" Value="False"/>
                                                <Condition Binding="{Binding IsSelectingUpcastedSpell}" Value="False"/>
                                                <Condition Binding="{Binding IsShowingItemsToThrow}" Value="False"/>
                                                <Condition Binding="{Binding LocalFocus.DataContext, ElementName=CAM_FixedSideBarList, Converter={StaticResource NullToBoolFalseConverter}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Control.Style>
                        </Control>
                    </Grid>

                    <Grid x:Name="CAM_ActionViewport"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="818"
                          Margin="40,16"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Loaded">
                                <ls:SetMoveFocusAction TargetName="ActionRadials"
                                                       FocusElement="{Binding ElementName=HotBarList}"
                                                       DeferFocusAction="True"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>

                        <ls:LSListBox x:Name="HotBarList"
                                      Height="818"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0"
                                      Background="Transparent"
                                      KeyboardNavigation.DirectionalNavigation="Contained"
                                      ActionNextEvent="UIDown"
                                      ActionPrevEvent="UIUp"
                                      LocalFocusSelector="{Binding ElementName=CAM_MainSelector,Mode=OneWay}">
                            <ls:LSListBox.Style>
                                <Style TargetType="{x:Type ls:LSListBox}" BasedOn="{StaticResource {x:Type ls:LSListBox}}">
                                    <Setter Property="ItemsSource" Value="{Binding SingleHotBar.SlotList}"/>
                                    <Setter Property="ItemContainerStyle" Value="{StaticResource CAM_ActionGridSlotContainer}"/>
                                    <Setter Property="ItemTemplate" Value="{StaticResource CAM_ActionGridSlotTemplate}"/>
                                    <Setter Property="ItemsPanel" Value="{StaticResource CAM_ActionGridPanel}"/>
                                    <Style.Triggers>
                                        <!-- Keep spells visible beside the sidebar, but never
                                             let both VMHotBarSlot lists own controller focus.
                                             BG3 nested variants/upcast/throw temporarily
                                             reactivate the central list. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_MetamagicModeToken}"/>
                                                <Condition Binding="{Binding IsShowingAContainerWithVariants}" Value="False"/>
                                                <Condition Binding="{Binding IsSelectingUpcastedSpell}" Value="False"/>
                                                <Condition Binding="{Binding IsShowingItemsToThrow}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_ItemsModeToken}">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding CurrentShownDeck.SlotList}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_AllModeToken}"/>
                                                <Condition Binding="{Binding IsShowingAContainerWithVariants}" Value="False"/>
                                                <Condition Binding="{Binding IsSelectingUpcastedSpell}" Value="False"/>
                                                <Condition Binding="{Binding IsShowingItemsToThrow}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.KeyboardHotBars}"/>
                                            <Setter Property="ItemContainerStyle"
                                                    Value="{StaticResource CAM_AllGroupContainerStyle}"/>
                                            <Setter Property="ItemTemplate"
                                                    Value="{StaticResource CAM_AllGroupTemplate}"/>
                                            <Setter Property="ItemsPanel"
                                                    Value="{StaticResource CAM_AllGroupsPanel}"/>
                                        </MultiDataTrigger>
                                        <!-- Native FixedSideBar is rendered independently.
                                             Entering its provider mode must not replace spells. -->
                                        <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_PassivesModeToken}">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.PassivesHotBar.SlotList}"/>
                                        </DataTrigger>
                                        <!-- Patch 8 HotBar.xaml:1759,4897-4900: DCHotBar exposes a
                                             separate executable SummonHotBar VMHotBar. Vanilla shows
                                             it instead of KeyboardHotBars when nonempty. Preserve
                                             native VMHotBarSlot identity and original A dispatch;
                                             nested/upcast/throw triggers below still win. -->
                                        <DataTrigger Binding="{Binding SummonHotBar.SlotList.Count, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}" Value="True">
                                            <Setter Property="ItemsSource" Value="{Binding SummonHotBar.SlotList}"/>
                                            <!-- The previous All mode can select nested VMHotBar
                                                 group templates; summon slots are individual
                                                 VMHotBarSlot objects, never VMHotBar groups. -->
                                            <Setter Property="ItemContainerStyle" Value="{StaticResource CAM_ActionGridSlotContainer}"/>
                                            <Setter Property="ItemTemplate" Value="{StaticResource CAM_ActionGridSlotTemplate}"/>
                                            <Setter Property="ItemsPanel" Value="{StaticResource CAM_ActionGridPanel}"/>
                                            <!-- Summons own the main surface even if the selected
                                                 header mode is Metamagic; the native sidebar's
                                                 input is disabled separately while nonempty. -->
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                        <!-- Native nested state always owns the executable surface, even when entered from a direct provider. -->
                                        <DataTrigger Binding="{Binding IsShowingAContainerWithVariants}" Value="True">
                                            <Setter Property="ItemsSource" Value="{Binding SingleHotBar.SlotList}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelectingUpcastedSpell}" Value="True">
                                            <Setter Property="ItemsSource" Value="{Binding SingleHotBar.SlotList}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsShowingItemsToThrow}" Value="True">
                                            <Setter Property="ItemsSource" Value="{Binding SingleHotBar.SlotList}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ls:LSListBox.Style>
                            <ls:LSListBox.ToolTip>
                                <ls:LSTooltip x:Name="CAM_ActionTooltip"
                                              ToolTipService.Placement="Right"
                                              ToolTipService.HorizontalOffset="40"
                                              ToolTipService.VerticalOffset="-40"
                                              ls:TooltipExtender.Context="Hotbar"/>
                            </ls:LSListBox.ToolTip>

                            <ls:LSListBox.Template>
                                <ControlTemplate TargetType="{x:Type ListBox}">
                                    <ls:LSScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                     VerticalScrollBarVisibility="Auto"
                                                     CanContentScroll="False"
                                                     ls:ScrollViewerHelper.VerticalScrollOffsetMargin="120"
                                                     ls:LSScrollViewer.ScrollToElement="{Binding FocusedElement, ElementName=ActionRadials}">
                                        <ItemsPresenter/>
                                    </ls:LSScrollViewer>
                                </ControlTemplate>
                            </ls:LSListBox.Template>

                            <b:Interaction.Triggers>
                                <!-- Only LB/RB may change provider state. Main-list
                                     LocalFocusChanged must not reset the Metamagic tab. -->
                                <b:EventTrigger EventName="LocalFocusChanged">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding IsEnabled, ElementName=HotBarList}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip"
                                                            PropertyName="Content"
                                                            Value="{Binding LocalFocus.DataContext.Content, ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction IsEnabled="{Binding LocalFocus.DataContext.Content, ElementName=HotBarList, Converter={StaticResource NullToBoolFalseConverter}}"
                                                           Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding ., ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction IsEnabled="{Binding LocalFocus.DataContext.Content, ElementName=HotBarList, Converter={StaticResource NullToBoolTrueConverter}}"
                                                           Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:InvokeCommandAction IsEnabled="False"
                                                           Command="{Binding DataContext.HighlightResourcesCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.ClearResourceHighlightsCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_SlotHover"/>
                                </b:EventTrigger>

                                <b:TimerTrigger EventName="LocalFocusChanged" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding IsEnabled, ElementName=HotBarList}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding LocalFocus.DataContext, ElementName=HotBarList, Converter={StaticResource NullToBoolFalseConverter}}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials"
                                                            PropertyName="Tag"
                                                            Value="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction IsEnabled="False"
                                                           Command="{Binding DataContext.HighlightResourcesCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.ClearResourceHighlightsCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                </b:TimerTrigger>

                                <!-- Programmatic tab entry changes SelectedIndex first, then the selected
                                     concrete container performs deferred SetMoveFocusAction. Wake presentation
                                     one tick later, but only from the LocalFocus that actually won navigation. -->
                                <b:TimerTrigger EventName="SelectionChanged" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior>
                                            <b:ConditionalExpression>
                                                <b:ComparisonCondition LeftOperand="{Binding LocalFocus.DataContext, ElementName=HotBarList}"
                                                                       Operator="NotEqual"
                                                                       RightOperand="{x:Null}"/>
                                                <b:ComparisonCondition LeftOperand="{Binding IsEnabled, ElementName=HotBarList}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                            </b:ConditionalExpression>
                                        </b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip"
                                                            PropertyName="Content"
                                                            Value="{Binding LocalFocus.DataContext.Content, ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding ., ElementName=HotBarList}"/>
                                    <b:ChangePropertyAction TargetName="ActionRadials"
                                                            PropertyName="Tag"
                                                            Value="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction IsEnabled="False"
                                                           Command="{Binding DataContext.HighlightResourcesCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.ClearResourceHighlightsCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                </b:TimerTrigger>
                            </b:Interaction.Triggers>
                        </ls:LSListBox>

                        <!-- Proven by 0.0.29: list and LocalFocusSelector share one coordinate root.
                             The native selector can represent both real slots and LSGrid empty-cell positions. -->
                        <Control x:Name="CAM_MainSelector"
                                 IsHitTestVisible="False"
                                 Focusable="False"
                                 Panel.ZIndex="2"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Template="{StaticResource SelectorTemplate}">
                            <Control.Style>
                                <Style TargetType="Control">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_MetamagicModeToken}"/>
                                                <Condition Binding="{Binding IsShowingAContainerWithVariants}" Value="False"/>
                                                <Condition Binding="{Binding IsSelectingUpcastedSpell}" Value="False"/>
                                                <Condition Binding="{Binding IsShowingItemsToThrow}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Control.Style>
                        </Control>
                    </Grid>
                    </Grid> <!-- CAM_ActionRowClip: clip only at catalog row, not between lists -->
                </Grid>
            </Grid>

            <Control x:Name="SlotAssignHolder" Visibility="Collapsed" IsEnabled="False" Focusable="False"/>

            <!-- Native controller feedback from PreloadedActionRadials_c.xaml:1830-1886.
                 This visual overlay owns no input/focus. It follows BG3's
                 actual state changes, never CAM's selected resource tabs. -->
            <ls:LSNineSliceImage x:Name="CAM_ControlNotifications"
                                 Opacity="0"
                                 Visibility="Collapsed"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,170"
                                 Panel.ZIndex="100"
                                 IsHitTestVisible="False"
                                 Focusable="False"
                                 Style="{StaticResource CAM_NotificationBG9Slice}">
                <TextBlock x:Name="CAM_NotificationText"
                           Text="{Binding Source='hfaac6c41gc244g45d5g952agb45eb21ee282', Converter={StaticResource TranslatedStringConverter}}"
                           Foreground="{StaticResource LS_PrimaryColor}"
                           FontSize="{StaticResource ScaledDefaultFontSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="36,20"/>
                <b:Interaction.Triggers>
                    <b:PropertyChangedTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasRangedSetActive}">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding ElementName=ToggleWeaponSet, Path=IsPressed}" Operator="Equal" RightOperand="True"/>
                                    <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasRangedSetActive}" Operator="Equal" RightOperand="True"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:ChangePropertyAction TargetName="CAM_NotificationText" PropertyName="Text" Value="{Binding Source='h6e99c201gc607g4da9gba50gb83f93d8a6e6', Converter={StaticResource TranslatedStringConverter}}"/>
                        <b:ControlStoryboardAction Storyboard="{StaticResource CAM_FadeInNotification}"/>
                    </b:PropertyChangedTrigger>
                    <b:PropertyChangedTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasRangedSetActive}">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding ElementName=ToggleWeaponSet, Path=IsPressed}" Operator="Equal" RightOperand="True"/>
                                    <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasMeleeSetActive}" Operator="Equal" RightOperand="True"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:ChangePropertyAction TargetName="CAM_NotificationText" PropertyName="Text" Value="{Binding Source='hfaac6c41gc244g45d5g952agb45eb21ee282', Converter={StaticResource TranslatedStringConverter}}"/>
                        <b:ControlStoryboardAction Storyboard="{StaticResource CAM_FadeInNotification}"/>
                    </b:PropertyChangedTrigger>
                    <b:PropertyChangedTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.IsDualWieldingToggledOn}">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding ElementName=ToggleDualWield, Path=IsPressed}" Operator="Equal" RightOperand="True"/>
                                    <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.IsDualWieldingToggledOn}" Operator="Equal" RightOperand="True"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:ChangePropertyAction TargetName="CAM_NotificationText" PropertyName="Text" Value="{Binding Source='hee8cf049gc819g4cd4g8b3ag7a0acc1f2f1b', Converter={StaticResource TranslatedStringConverter}}"/>
                        <b:ControlStoryboardAction Storyboard="{StaticResource CAM_FadeInNotification}"/>
                    </b:PropertyChangedTrigger>
                    <b:PropertyChangedTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.IsDualWieldingToggledOn}">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding ElementName=ToggleDualWield, Path=IsPressed}" Operator="Equal" RightOperand="True"/>
                                    <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.IsDualWieldingToggledOn}" Operator="Equal" RightOperand="False"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:ChangePropertyAction TargetName="CAM_NotificationText" PropertyName="Text" Value="{Binding Source='h69107c78gd9efg4fd2ga137g427cc0280604', Converter={StaticResource TranslatedStringConverter}}"/>
                        <b:ControlStoryboardAction Storyboard="{StaticResource CAM_FadeInNotification}"/>
                    </b:PropertyChangedTrigger>
                </b:Interaction.Triggers>
            </ls:LSNineSliceImage>

            <ls:AlignableWrapPanel x:Name="ButtonHintsContainer"
                                   Style="{StaticResource ButtonHint.Container.CenterWrap}"
                                   HorizontalAlignment="Center"
                                   HorizontalContentAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Width="Auto"
                                   MaxWidth="1320"
                                   FlowDirection="LeftToRight"
                                   Margin="26,0,26,56">
                <!-- Original Patch 8 ActionRadials: while choosing a thrown item,
                     UIDelete returns directly to world targeting. This is
                     native nested gameplay, not radial layout editing. -->
                <ls:LSButton x:Name="ToWorldButton"
                             Tag="{Binding Source='hf6830bd6g4b21g4a7aga963g30da537e64b7', Converter={StaticResource TranslatedStringConverter}}"
                             ContentTemplate="{StaticResource ControllerButtonHint}"
                             BoundEvent="UIDelete"
                             Content="{Binding CurrentPlayer.UIData.InputEvents, ConverterParameter=UIDelete, Converter={StaticResource FindInputEventConverter}}"
                             HorizontalAlignment="Left"
                             Width="Auto"
                             Visibility="Collapsed"
                             Command="{Binding CustomEvent}"
                             CommandParameter="CloseRadials"/>

                <ls:LSButton x:Name="SelectButtonVisual"
                             BoundEvent="UIAccept"
                             EatInput="False"
                             Tag="{Binding Source='h04f38549g65b8g4b72g834eg87ee8863fdc5', Converter={StaticResource TranslatedStringConverter}}"
                             ContentTemplate="{StaticResource ControllerButtonHint}"
                             Content="{Binding CurrentPlayer.UIData.InputEvents, ConverterParameter=UIAccept, Converter={StaticResource FindInputEventConverter}}"
                             HorizontalContentAlignment="Left"
                             HorizontalAlignment="Left"
                             Width="Auto">
                    <!-- Original Patch 8 radial UI: the accept hint emits the
                         native error sound for a refused action, without
                         consuming A or bypassing UseSlotCommand.CanUse. -->
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="Click">
                            <b:Interaction.Behaviors>
                                <b:ConditionBehavior>
                                    <b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag.CanUse, ElementName=ActionRadials}" Operator="Equal" RightOperand="False"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag.ThothError, ElementName=ActionRadials, Converter={StaticResource NullToBoolFalseConverter}, ConverterParameter='EmptyString'}" Operator="Equal" RightOperand="True"/>
                                    </b:ConditionalExpression>
                                </b:ConditionBehavior>
                            </b:Interaction.Behaviors>
                            <ls:LSPlaySound Sound="UI_Shared_Error"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ls:LSButton>

                <ls:LSButton x:Name="ShowContextMenu"
                             Visibility="Collapsed"
                             IsEnabled="False"
                             IsHitTestVisible="False"
                             Focusable="False"
                             Width="0"
                             Height="0"
                             Command="{x:Null}"/>

                <ls:LSButton x:Name="CancelConcentrationButton"
                             Style="{StaticResource ControllerHoldButtonStyle}"
                             Content="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='UIEndTurn'}"
                             Command="{Binding ReleaseConcentrationCommand}"
                             CommandParameter="{Binding CurrentPlayer.SelectedCharacter}"
                             Tag="{Binding Source='h1018e7a5gdb9ag4b51g9898gc30c5b0ab518', Converter={StaticResource TranslatedStringConverter}}"
                             VerticalAlignment="Center"
                             EatInput="False"
                             Visibility="{Binding CurrentPlayer.SelectedCharacter.ConcentrationSpell, Converter={StaticResource NullToCollapsedConverter}}"
                             HorizontalContentAlignment="Left"
                             HorizontalAlignment="Left"
                             Margin="10,0,20,0"
                             Width="Auto"/>

                <!-- Native Patch 8 Controller ActionRadials weapon-set shortcut.
                     Deliberately no BoundEvent: the original hold-button style
                     owns its input. Previous extra input bindings consumed
                     ordinary grid-left presses or failed to re-arm. -->
                <ls:LSButton x:Name="ToggleWeaponSet"
                             Style="{StaticResource ControllerHoldButtonStyle}"
                             Content="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='UISelectionLeft'}"
                             Command="{Binding SwitchWeaponSetCommand}"
                             Tag="{Binding Source='h7f2d9806g87bdg42a3g934ag9d051a036638', Converter={StaticResource TranslatedStringConverter}}"
                             HorizontalContentAlignment="Left"
                             VerticalAlignment="Center"
                             EatInput="False"
                             HorizontalAlignment="Left"
                             Margin="10,0,20,0"
                             Width="Auto"/>

                <ls:LSButton x:Name="ToggleDualWield"
                             BoundEvent="UISelectionRight"
                             Style="{StaticResource ControllerHoldButtonStyle}"
                             Command="{Binding ToggleDualWieldingCommand}"
                             Content="{Binding CurrentPlayer.UIData.InputEvents, ConverterParameter=UISelectionRight, Converter={StaticResource FindInputEventConverter}}"
                             Tag="{Binding Source='hfd571216g8e69g4699g8396gb764f90db389', Converter={StaticResource TranslatedStringConverter}}"
                             HorizontalContentAlignment="Left"
                             VerticalAlignment="Center"
                             EatInput="False"
                             HorizontalAlignment="Left"
                             Margin="10,0,20,0"
                             Width="Auto"/>

                <ls:LSButton x:Name="UseSlotBinding"
                             Command="{Binding UseSlotCommand}"
                             CommandParameter="{Binding Tag, ElementName=ActionRadials}"
                             Height="0"
                             BoundEvent="UIAccept"
                             HorizontalAlignment="Left"/>

                <ls:LSButton x:Name="CancelButton"
                             BoundEvent="UICancel"
                             Command="{Binding ClearSingleHotbarCommand}"
                             Tag="{Binding Source='h01d5c470g61bfg498cgb17eg7be425444fa5', Converter={StaticResource TranslatedStringConverter}}"
                             ContentTemplate="{StaticResource ControllerButtonHint}"
                             Content="{Binding CurrentPlayer.UIData.InputEvents, ConverterParameter=UICancel, Converter={StaticResource FindInputEventConverter}}"
                             HorizontalContentAlignment="Left"
                             HorizontalAlignment="Left"
                             Width="Auto">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="LSButtonReleased">
                            <b:InvokeCommandAction Command="{Binding ActionCancelCommand}"/>
                            <ls:SetMoveFocusAction TargetName="ActionRadials" FocusElement="{Binding ElementName=HotBarList}" DeferFocusAction="True"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ls:LSButton>

                <ls:LSInputBinding x:Name="PinTooltipBinding" Style="{StaticResource PinTooltipBindingStyle}" BoundEvent="UIShowInfo"/>
                <ls:LSInputBinding x:Name="ShortcutMenuBinding" Command="{Binding CustomEvent}" BoundEvent="PanelSelect" CommandParameter="ToggleShortcutMenu"/>
            </ls:AlignableWrapPanel>
        </Grid>

        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsShowingItemsToThrow}" Value="True">
                <Setter TargetName="ToWorldButton" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasRangedAttack}" Value="False">
                <Setter TargetName="ToggleWeaponSet" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.IsDualWieldingAllowed}" Value="False">
                <Setter TargetName="ToggleDualWield" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Tag.SlotType, ElementName=ActionRadials, FallbackValue='Empty'}" Value="Empty">
                <Setter TargetName="PinTooltipBinding" Property="IsEnabled" Value="False"/>
                <Setter TargetName="UseSlotBinding" Property="IsEnabled" Value="False"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=Tag.CanUse, ElementName=ActionRadials}" Value="False">
                <Setter TargetName="UseSlotBinding" Property="IsEnabled" Value="{Binding Tag.Content.IsContainer, ElementName=ActionRadials, FallbackValue=False}"/>
            </DataTrigger>


            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsShowingAContainerWithVariants}" Value="False"/>
                    <Condition Binding="{Binding IsSelectingUpcastedSpell}" Value="False"/>
                    <Condition Binding="{Binding IsShowingItemsToThrow}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                <Setter TargetName="CancelButton" Property="Tag" Value="{Binding Source='h411fb88eg5261g437aga291g2fb260e633c6', Converter={StaticResource TranslatedStringConverter}}"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.IsShapeShifted}" Value="True">
                <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.CharacterType}" Value="Summon">
                <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.CharacterType}" Value="Follower">
                <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
