                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                    <b:ChangePropertyAction TargetName="CAM_NestedReturnMarker"
                                            PropertyName="Tag"
                                            Value="{StaticResource CAM_NestedRestoringToken}"/>
                    <b:InvokeCommandAction Command="{Binding Command, ElementName=CAM_ProviderRestoreCommand}"
                                           CommandParameter="{Binding CommandParameter, ElementName=CAM_ProviderRestoreCommand}"/>
                </b:PropertyChangedTrigger>
                <b:PropertyChangedTrigger Binding="{Binding SingleHotBar.SlotList.Count}">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_NestedReturnMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_NestedRestoringToken}"/>
                                <b:ComparisonCondition LeftOperand="{Binding SingleHotBar.SlotList.Count}"
                                                       Operator="GreaterThan"
                                                       RightOperand="0"/>
                                <!-- Metamagic restores focus to the parallel sidebar,
                                     never the central spell grid. -->
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="NotEqual"
                                                       RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:ChangePropertyAction TargetName="HotBarList"
                                            PropertyName="Tag"
                                            Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                    <b:ChangePropertyAction TargetName="HotBarList"
                                            PropertyName="SelectedIndex"
                                            Value="0"/>
                    <b:ChangePropertyAction TargetName="CAM_NestedReturnMarker"
                                            PropertyName="Tag"
                                            Value="{x:Null}"/>
                </b:PropertyChangedTrigger>
                <!-- Direct VMHotBar providers do not need a filter command after nested exit.
                     When the restoring marker is armed, their ItemsSource is already live again. -->
                <b:DataTrigger Binding="{Binding Tag, ElementName=CAM_NestedReturnMarker}" Value="{StaticResource CAM_NestedRestoringToken}">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_PassivesModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="0"/>
                    <b:ChangePropertyAction TargetName="CAM_NestedReturnMarker" PropertyName="Tag" Value="{x:Null}"/>
                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding Tag, ElementName=CAM_NestedReturnMarker}" Value="{StaticResource CAM_NestedRestoringToken}">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_ItemsModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="0"/>
                    <b:ChangePropertyAction TargetName="CAM_NestedReturnMarker" PropertyName="Tag" Value="{x:Null}"/>
                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding Tag, ElementName=CAM_NestedReturnMarker}" Value="{StaticResource CAM_NestedRestoringToken}">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_AllModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <!-- Recreate the selected outer VMHotBar group. Its template then hands
                         focus to the first concrete VMHotBarSlot through the existing reset token. -->
                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="0"/>
                    <b:ChangePropertyAction TargetName="CAM_NestedReturnMarker" PropertyName="Tag" Value="{x:Null}"/>
                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding Tag, ElementName=CAM_NestedReturnMarker}" Value="{StaticResource CAM_NestedRestoringToken}">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <!-- Native variant selection temporarily uses HotBarList, but the
                         owning top-level Metamagic tab is CAM_FixedSideBarList. -->
                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="SelectedIndex" Value="-1"/>
                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="SelectedIndex" Value="0"/>
                    <b:ChangePropertyAction TargetName="CAM_NestedReturnMarker" PropertyName="Tag" Value="{x:Null}"/>
                </b:DataTrigger>


            </b:Interaction.Triggers>

            <Grid x:Name="MainHotbarListHolder" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="CAM_AutoCatalogFocusRoot"
                      Width="{Binding ActualWidth, ElementName=ActionRadials}"
                      MaxWidth="1400"
                      MinWidth="800"
                      Height="966"
                      Background="Transparent">
                    <!-- The extra 32px title row is compensated by the center
                         alignment offset. The existing 84px tab strip and 850px
                         action viewport keep their previous screen positions. -->
                    <Grid.RenderTransform>
                        <TranslateTransform Y="-16"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="84"/>
                        <RowDefinition Height="850"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- A reserved row ABOVE the native resource artwork, never
                         an overlay inside the 84px tab strip. The resource name
                         is BG3-owned; special-provider names are presentation
                         fallback labels pending proof of localization handles. -->
                    <Grid x:Name="CAM_SelectedTabTitleArea"
                          Grid.Row="0"
                          Grid.ColumnSpan="2"
                          Height="32"
                          MaxWidth="800"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Focusable="False">
                        <TextBlock x:Name="CAM_SelectedResourceName"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="760"
                                   FontSize="{StaticResource ScaledDefaultFontSize}"
                                   Foreground="{StaticResource LS_PrimaryColor}"
                                   Effect="{StaticResource ShadowEffect}"
                                   IsHitTestVisible="False"
                                   Focusable="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding SelectedItem.ActionResource.Name, ElementName=CAM_ResourceTabs}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_CantripsModeToken}">
                                            <Setter Property="Text" Value="Cantrips"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_ItemsModeToken}">
                                            <Setter Property="Text" Value="Items"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_MetamagicModeToken}">
                                            <Setter Property="Text" Value="Metamagic"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_PassivesModeToken}">
                                            <Setter Property="Text" Value="Passives"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_AllModeToken}">
                                            <Setter Property="Text" Value="All"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <DockPanel Grid.ColumnSpan="2" x:Name="CAM_ResourceHeader"
                               Grid.Row="1"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               MaxWidth="1320"
                               Height="84">
                        <ls:LSButton x:Name="CAM_TabLeft"
                                     BoundEvent="UITabPrev"
                                     DockPanel.Dock="Left"
                                     ContentTemplate="{StaticResource ControllerButtonHintImageOnly}"
                                     Content="{Binding CurrentPlayer.UIData.InputEvents, ConverterParameter=UITabPrev, Converter={StaticResource FindInputEventConverter}}"
                                     Width="{StaticResource ScaledControllerHintSize}"
                                     Height="{StaticResource ScaledControllerHintSize}"
                                     EatInput="False"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0">
                            <b:Interaction.Triggers>
                                <!-- All -> Passives. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_AllModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_PassivesModeToken}"/>
                                </b:EventTrigger>

                                <!-- Passives -> Metamagic when the native FixedSideBar exists. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_PassivesModeToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Visibility, ElementName=CAM_MetamagicTab}" Operator="Equal" RightOperand="Visible"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <!-- Restore a native resource-filtered spell grid alongside
                                         metamagic, even when arriving from Items/Passives. -->
                                    <b:InvokeCommandAction
                                        IsEnabled="{Binding SelectedItem, ElementName=CAM_ResourceTabs, Converter={StaticResource NullToBoolFalseConverter}}"
                                        Command="{Binding FilterActionResourceCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=CAM_ResourceTabs}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_MetamagicModeToken}"/>
                                </b:EventTrigger>

                                <!-- Passives -> Items when Metamagic is absent. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_PassivesModeToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Visibility, ElementName=CAM_MetamagicTab}" Operator="Equal" RightOperand="Collapsed"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_ItemsModeToken}"/>
                                    <b:InvokeCommandAction Command="{Binding SetCurrentShownDeckCommand}" CommandParameter="ItemHotBar"/>
                                </b:EventTrigger>

                                <!-- Metamagic -> Items. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_ItemsModeToken}"/>
                                    <b:InvokeCommandAction Command="{Binding SetCurrentShownDeckCommand}" CommandParameter="ItemHotBar"/>
                                </b:EventTrigger>

                                <!-- Items -> Cantrips when available. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_ItemsModeToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasCantrips}" Operator="Equal" RightOperand="{StaticResource TrueValue}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_CantripsModeToken}"/>
                                    <b:InvokeCommandAction Command="{Binding FilterCantripsCommand}" CommandParameter="{StaticResource CAM_CantripFilterParameter}"/>
                                </b:EventTrigger>

                                <!-- Items -> last native resource when Cantrips is unavailable. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_ItemsModeToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasCantrips}" Operator="Equal" RightOperand="{StaticResource FalseValue}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabReturnLastToken}"/>
                                    <ls:SelectNextListBoxItem Reversed="True" TargetObject="{Binding ElementName=CAM_ResourceTabs}" ForceMode="Cycle"/>
                                </b:EventTrigger>

                                <!-- Cantrips -> last native resource. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_CantripsModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabReturnLastToken}"/>
                                    <ls:SelectNextListBoxItem Reversed="True" TargetObject="{Binding ElementName=CAM_ResourceTabs}" ForceMode="Cycle"/>
                                </b:EventTrigger>

                                <!-- First native resource -> All fallback. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding SelectedIndex, ElementName=CAM_ResourceTabs}" Operator="Equal" RightOperand="0"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_AllModeToken}"/>
                                </b:EventTrigger>

                                <!-- Ordinary previous native resource. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding SelectedIndex, ElementName=CAM_ResourceTabs}" Operator="GreaterThan" RightOperand="0"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabCycleLeftToken}"/>
                                    <ls:SelectNextListBoxItem Reversed="True" TargetObject="{Binding ElementName=CAM_ResourceTabs}" ForceMode="Cycle"/>
                                </b:EventTrigger>

                                <b:TimerTrigger EventName="Click" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{StaticResource CAM_TabEnterSpecialToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="NotEqual" RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="0"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:TimerTrigger>
                                <!-- Meta shoulder entry focuses its parallel native-slot region. -->
                                <b:TimerTrigger EventName="Click" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{StaticResource CAM_TabEnterSpecialToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <!-- Selection and controller focus are distinct native
                                         states. Explicitly transfer input ownership to the
                                         enabled sidebar as the game does for HotBarList,
                                         then select its first concrete VMHotBarSlot. -->
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                                    <ls:SetMoveFocusAction TargetName="ActionRadials"
                                                           FocusElement="{Binding ElementName=CAM_FixedSideBarList}"
                                                           DeferFocusAction="True"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="SelectedIndex" Value="0"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:TimerTrigger>

                                <b:TimerTrigger EventName="Click" MillisecondsPerTick="90" TotalTicks="1">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{StaticResource CAM_TabReturnLastToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="0"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:TimerTrigger>
                            </b:Interaction.Triggers>
                        </ls:LSButton>

                        <ls:LSButton x:Name="CAM_TabRight"
                                     BoundEvent="UITabNext"
                                     DockPanel.Dock="Right"
                                     ContentTemplate="{StaticResource ControllerButtonHintImageOnly}"
                                     Content="{Binding CurrentPlayer.UIData.InputEvents, ConverterParameter=UITabNext, Converter={StaticResource FindInputEventConverter}}"
                                     Width="{StaticResource ScaledControllerHintSize}"
                                     Height="{StaticResource ScaledControllerHintSize}"
                                     EatInput="False"
                                     VerticalAlignment="Center"
                                     Margin="12,0,0,0">
                            <b:Interaction.Triggers>
                                <!-- All -> first native resource. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_AllModeToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding SelectedItem, ElementName=CAM_ResourceTabs}" Operator="NotEqual" RightOperand="{x:Null}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabReturnFirstToken}"/>
                                    <b:InvokeCommandAction Command="{Binding FilterActionResourceCommand}" CommandParameter="{Binding SelectedItem, ElementName=CAM_ResourceTabs}"/>
                                </b:EventTrigger>

                                <!-- Passives -> All fallback. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_PassivesModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_AllModeToken}"/>
                                </b:EventTrigger>

                                <!-- Metamagic -> Passives. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_PassivesModeToken}"/>
                                </b:EventTrigger>

                                <!-- Items -> Metamagic when the native FixedSideBar exists. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_ItemsModeToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Visibility, ElementName=CAM_MetamagicTab}" Operator="Equal" RightOperand="Visible"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <!-- Restore a native resource-filtered spell grid alongside
                                         metamagic, even when arriving from Items/Passives. -->
                                    <b:InvokeCommandAction
                                        IsEnabled="{Binding SelectedItem, ElementName=CAM_ResourceTabs, Converter={StaticResource NullToBoolFalseConverter}}"
                                        Command="{Binding FilterActionResourceCommand}"
                                        CommandParameter="{Binding SelectedItem, ElementName=CAM_ResourceTabs}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_MetamagicModeToken}"/>
                                </b:EventTrigger>

                                <!-- Items -> Passives when Metamagic is absent. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_ItemsModeToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Visibility, ElementName=CAM_MetamagicTab}" Operator="Equal" RightOperand="Collapsed"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_PassivesModeToken}"/>
                                </b:EventTrigger>

                                <!-- Cantrips -> Items. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_CantripsModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabEnterSpecialToken}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_ItemsModeToken}"/>
                                    <b:InvokeCommandAction Command="{Binding SetCurrentShownDeckCommand}" CommandParameter="ItemHotBar"/>
                                </b:EventTrigger>

                                <!-- Resource -> next resource; wrap is handled by CAM_ResourceTabs.SelectionChanged. -->
                                <b:EventTrigger EventName="Click">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <!-- Block follow-on provider transitions during the same shoulder Click. -->
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{x:Null}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{StaticResource CAM_TabCycleRightToken}"/>
                                    <ls:SelectNextListBoxItem TargetObject="{Binding ElementName=CAM_ResourceTabs}" ForceMode="Cycle"/>
                                </b:EventTrigger>

                                <b:TimerTrigger EventName="Click" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{StaticResource CAM_TabEnterSpecialToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="NotEqual" RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="0"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:TimerTrigger>
                                <!-- Meta shoulder entry focuses its parallel native-slot region. -->
                                <b:TimerTrigger EventName="Click" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{StaticResource CAM_TabEnterSpecialToken}"/>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Operator="Equal" RightOperand="{StaticResource CAM_MetamagicModeToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <!-- Selection and controller focus are distinct native
                                         states. Explicitly transfer input ownership to the
                                         enabled sidebar as the game does for HotBarList,
                                         then select its first concrete VMHotBarSlot. -->
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                                    <ls:SetMoveFocusAction TargetName="ActionRadials"
                                                           FocusElement="{Binding ElementName=CAM_FixedSideBarList}"
                                                           DeferFocusAction="True"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:ChangePropertyAction TargetName="CAM_FixedSideBarList" PropertyName="SelectedIndex" Value="0"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:TimerTrigger>

                                <b:TimerTrigger EventName="Click" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors><b:ConditionBehavior><b:ConditionalExpression>
                                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{StaticResource CAM_TabReturnFirstToken}"/>
                                    </b:ConditionalExpression></b:ConditionBehavior></b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="Tag" Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="0"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:TimerTrigger>
                            </b:Interaction.Triggers>
                        </ls:LSButton>

                        <Grid x:Name="CAM_ResourceStrip"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Height="84">
                            <ls:LSNineSliceImage x:Name="CAM_HotbarBodyResourcesBg"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Bottom"
                                                 Height="64"
                                                 MinWidth="208"
                                                 Width="{Binding ActualWidth, ElementName=CAM_TopTabs, Converter={StaticResource AddConverter}, ConverterParameter=208}"
                                                 ImageSource="{StaticResource CAM_BarResources}"
                                                 Slices="104,0"/>
                            <StackPanel x:Name="CAM_TopTabs"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom">
                        <ls:LSListBox x:Name="CAM_ResourceTabs"
                                      ItemsSource="{Binding CurrentPlayer.UIData.ActionResourcesCostPreview}"
                                      SelectedIndex="0"
                                      Tag="{x:Null}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      MaxWidth="720"
                                      KeyboardNavigation.DirectionalNavigation="Cycle"
                                      ItemContainerStyle="{StaticResource CAM_ResourceTabItemStyle}"
                                      ItemTemplate="{StaticResource CAM_ResourceTabTemplate}"
                                      ItemsPanel="{StaticResource CAM_ResourceTabsPanel}">
                            <ls:LSListBox.Template>
                                <ControlTemplate TargetType="{x:Type ListBox}">
                                    <Grid Background="Transparent">
                                        <ls:LSScrollViewer x:Name="CAM_ResourceTabsScroller"
                                                           Focusable="False"
                                                           HorizontalScrollBarVisibility="Hidden"
                                                           VerticalScrollBarVisibility="Disabled"
                                                           CanContentScroll="False"
                                                           ls:LSScrollViewer.ScrollToElement="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ItemsPresenter HorizontalAlignment="Left"/>
                                            <b:Interaction.Triggers>
                                                <b:EventTrigger EventName="TargetPositionChanged">
                                                    <b:ChangePropertyAction PropertyName="HorizontalScrollOffset"
                                                                            TargetName="CAM_ResourceTabsScroller"
                                                                            Value="{Binding TargetPosition, ElementName=CAM_ResourceTabsScroller}"/>
                                                </b:EventTrigger>
                                            </b:Interaction.Triggers>
                                        </ls:LSScrollViewer>
                                    </Grid>
                                </ControlTemplate>
                            </ls:LSListBox.Template>

                            <b:Interaction.Triggers>
                                <!-- Right wrap: prefer the native Cantrips provider when this character has cantrips. -->
                                <b:EventTrigger EventName="SelectionChanged">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior>
                                            <b:ConditionalExpression>
                                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}"
                                                                       Operator="Equal"
                                                                       RightOperand="{StaticResource CAM_TabCycleRightToken}"/>
                                                <b:ComparisonCondition LeftOperand="{Binding SelectedIndex, ElementName=CAM_ResourceTabs}"
                                                                       Operator="Equal"
                                                                       RightOperand="0"/>
                                                <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasCantrips}"
                                                                       Operator="Equal"
                                                                       RightOperand="{StaticResource TrueValue}"/>
                                            </b:ConditionalExpression>
                                        </b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_CantripsModeToken}"/>
                                    <b:InvokeCommandAction Command="{Binding FilterCantripsCommand}"
                                                           CommandParameter="{StaticResource CAM_CantripFilterParameter}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:EventTrigger>

                                <!-- Without Cantrips, wrap to BG3's native ItemHotBar deck. -->
                                <b:EventTrigger EventName="SelectionChanged">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior>
                                            <b:ConditionalExpression>
                                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}" Operator="Equal" RightOperand="{StaticResource CAM_TabCycleRightToken}"/>
                                                <b:ComparisonCondition LeftOperand="{Binding SelectedIndex, ElementName=CAM_ResourceTabs}" Operator="Equal" RightOperand="0"/>
                                                <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.HasCantrips}" Operator="Equal" RightOperand="{StaticResource FalseValue}"/>
                                            </b:ConditionalExpression>
                                        </b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{StaticResource CAM_ItemsModeToken}"/>
                                    <b:InvokeCommandAction Command="{Binding SetCurrentShownDeckCommand}" CommandParameter="ItemHotBar"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:EventTrigger>

                                <!-- Ordinary right movement within native resources. -->
                                <b:EventTrigger EventName="SelectionChanged">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior>
                                            <b:ConditionalExpression>
                                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}"
                                                                       Operator="Equal"
                                                                       RightOperand="{StaticResource CAM_TabCycleRightToken}"/>
                                                <b:ComparisonCondition LeftOperand="{Binding SelectedIndex, ElementName=CAM_ResourceTabs}"
                                                                       Operator="GreaterThan"
                                                                       RightOperand="0"/>
                                            </b:ConditionalExpression>
                                        </b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:InvokeCommandAction IsEnabled="{Binding SelectedItem, ElementName=CAM_ResourceTabs, Converter={StaticResource NullToBoolFalseConverter}}"
                                                           Command="{Binding FilterActionResourceCommand}"
                                                           CommandParameter="{Binding SelectedItem, ElementName=CAM_ResourceTabs}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:EventTrigger>

                                <!-- Passives -> last resource: prepare the native resource result while
                                     HotBarList still owns Passives. -->
                                <b:EventTrigger EventName="SelectionChanged">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior>
                                            <b:ConditionalExpression>
                                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}"
                                                                       Operator="Equal"
                                                                       RightOperand="{StaticResource CAM_TabReturnLastToken}"/>
                                            </b:ConditionalExpression>
                                        </b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:InvokeCommandAction IsEnabled="{Binding SelectedItem, ElementName=CAM_ResourceTabs, Converter={StaticResource NullToBoolFalseConverter}}"
                                                           Command="{Binding FilterActionResourceCommand}"
                                                           CommandParameter="{Binding SelectedItem, ElementName=CAM_ResourceTabs}"/>
                                </b:EventTrigger>

                                <!-- Ordinary left resource movement. -->
                                <b:EventTrigger EventName="SelectionChanged">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior>
                                            <b:ConditionalExpression>
                                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}"
                                                                       Operator="Equal"
                                                                       RightOperand="{StaticResource CAM_TabCycleLeftToken}"/>
                                            </b:ConditionalExpression>
                                        </b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ActionTooltip" PropertyName="Content" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="LocalFocus" Value="{x:Null}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList" PropertyName="SelectedIndex" Value="-1"/>
                                    <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:InvokeCommandAction IsEnabled="{Binding SelectedItem, ElementName=CAM_ResourceTabs, Converter={StaticResource NullToBoolFalseConverter}}"
                                                           Command="{Binding FilterActionResourceCommand}"
                                                           CommandParameter="{Binding SelectedItem, ElementName=CAM_ResourceTabs}"/>
                                    <b:ChangePropertyAction TargetName="CAM_TabCycleMarker" PropertyName="Tag" Value="{x:Null}"/>
                                </b:EventTrigger>

                                <b:TimerTrigger EventName="SelectionChanged" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior>
                                            <b:ConditionalExpression>
                                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_TabCycleMarker}"
                                                                       Operator="NotEqual"
                                                                       RightOperand="{StaticResource CAM_TabReturnLastToken}"/>
                                            </b:ConditionalExpression>
                                        </b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="HotBarList"
                                                            PropertyName="Tag"
                                                            Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                                    <b:ChangePropertyAction TargetName="HotBarList"
                                                            PropertyName="SelectedIndex"
                                                            Value="0"/>
                                </b:TimerTrigger>

                                <!-- The native controller state machine sets ActionRadials.Metadata
                                     to MoveToEnd for opening from the opposite shoulder.
                                     Preserve original ActionRadials.xaml Loaded first/last
                                     semantics, but use CAM's automatic rightmost All provider. -->
                                <b:EventTrigger EventName="Loaded">
                                    <b:Interaction.Behaviors>
                                        <b:ConditionBehavior>
                                            <b:ConditionalExpression>
                                                <b:ComparisonCondition LeftOperand="{Binding Metadata, ElementName=ActionRadials}"
                                                                       Operator="NotEqual" RightOperand="MoveToEnd"/>
                                            </b:ConditionalExpression>
                                        </b:ConditionBehavior>
                                    </b:Interaction.Behaviors>
                                    <b:ChangePropertyAction TargetName="CAM_ProviderModeMarker" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:InvokeCommandAction IsEnabled="{Binding SelectedItem, ElementName=CAM_ResourceTabs, Converter={StaticResource NullToBoolFalseConverter}}"
                                                           Command="{Binding FilterActionResourceCommand}"
                                                           CommandParameter="{Binding SelectedItem, ElementName=CAM_ResourceTabs}"/>
                                </b:EventTrigger>

                                <b:EventTrigger EventName="Loaded">
                                    <b:Interaction.Behaviors>
