<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ls="clr-namespace:ls;assembly=Code"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions">

    <!-- Literal value from Patch 8 HotBar.xaml: <Thickness x:Key="ResourceBackgroundMargin">0</Thickness>.
         The CAM alias is local because the keyboard page's ResourceDictionary is not
         the controller library's resource scope. Do not reference an undeclared alias. -->
    <Thickness x:Key="CAM_ResourceBackgroundMargin">0</Thickness>
    <!-- CAM owns composition only. Each focused/executed action remains a native VMHotBarSlot. -->
    <System:Double x:Key="CAM_ActionGridCellSize">120</System:Double>
    <!-- Exact Patch 8 keyboard HotBar Action Resources presentation, captured from
         Mods/MainUI/GUI/Pages/HotBar.xaml in Xbox App 1.8.910.0. -->
    <BitmapImage x:Key="CAM_BarResources"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/bar_resources.png"/>
    <BitmapImage x:Key="CAM_BoxResourceBg"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resource_empty.png"/>
    <BitmapImage x:Key="CAM_BoxResource"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resource_d.png"/>
    <BitmapImage x:Key="CAM_BoxResourceH"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resource_h.png"/>
    <BitmapImage x:Key="CAM_BoxResourceDisabled"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resource_missing.png"/>
    <BitmapImage x:Key="CAM_BoxResourceNumBg"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resourceNum_empty.png"/>
    <BitmapImage x:Key="CAM_BoxResourceNum"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resourceNum_d.png"/>
    <BitmapImage x:Key="CAM_BoxResourceNumH"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resourceNum_h.png"/>
    <BitmapImage x:Key="CAM_BoxResourceNumDisabled"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/BottomBar/neo/box_resourceNum_missing.png"/>
    <BitmapImage x:Key="CAM_ItemsProviderIcon"
                 UriSource="pack://application:,,,/Core;component/Assets/Shared/ico_container_more_d.png"/>
    <BitmapImage x:Key="CAM_AllProviderIcon"
                 UriSource="pack://application:,,,/GustavNoesisGUI;component/Assets/Shared/ico_tab_all.png"/>
    <System:String x:Key="CAM_ResetFirstFocusToken">CAM_ResetFirstFocus</System:String>
    <System:String x:Key="CAM_NestedEnteredToken">CAM_NestedEntered</System:String>
    <System:String x:Key="CAM_NestedRestoringToken">CAM_NestedRestoring</System:String>
    <System:String x:Key="CAM_TabCycleRightToken">CAM_TabCycleRight</System:String>
    <System:String x:Key="CAM_TabCycleLeftToken">CAM_TabCycleLeft</System:String>
    <System:String x:Key="CAM_TabEnterPassivesToken">CAM_TabEnterPassives</System:String>
    <System:String x:Key="CAM_TabReturnFirstToken">CAM_TabReturnFirst</System:String>
    <System:String x:Key="CAM_TabReturnLastToken">CAM_TabReturnLast</System:String>
    <System:String x:Key="CAM_TabEnterSpecialToken">CAM_TabEnterSpecial</System:String>
    <System:String x:Key="CAM_CantripsModeToken">CAM_CantripsMode</System:String>
    <System:String x:Key="CAM_ItemsModeToken">CAM_ItemsMode</System:String>
    <System:String x:Key="CAM_AllModeToken">CAM_AllMode</System:String>
    <System:String x:Key="CAM_MetamagicModeToken">CAM_MetamagicMode</System:String>
    <System:String x:Key="CAM_PassivesModeToken">CAM_PassivesMode</System:String>
    <System:String x:Key="CAM_CantripFilterParameter">h7d02199dg44ecg4a1egbcacg9cc1cec197b3</System:String>

    <Style x:Key="CAM_ActionGridSlotContainer"
           TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="ls:MoveFocus.Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="104"/>
        <Setter Property="Height" Value="104"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Tag" Value="{Binding .}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Width="104" Height="104" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <b:Interaction.Triggers>
                            <b:DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True">
                                <b:Interaction.Behaviors>
                                    <b:ConditionBehavior>
                                        <b:ConditionalExpression>
                                            <b:ComparisonCondition LeftOperand="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ls:LSListBox}}}"
                                                                   Operator="Equal"
                                                                   RightOperand="{StaticResource CAM_ResetFirstFocusToken}"/>
                                        </b:ConditionalExpression>
                                    </b:ConditionBehavior>
                                </b:Interaction.Behaviors>
                                <ls:SetMoveFocusAction TargetName="ActionRadials"
                                                       FocusElement="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                       DeferFocusAction="True"/>
                                <b:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ls:LSListBox}}}"
                                                        PropertyName="Tag"
                                                        Value="{x:Null}"/>
                            </b:DataTrigger>
                        </b:Interaction.Triggers>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SlotType}" Value="Empty">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Focusable" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CAM_ActionGridSlotTemplate">
        <!-- VMHotBarSlot remains the focus/dispatch object. Non-items keep the proven 104x104
             assignment icon surface; item slots delegate presentation to the same VMItem templates
             used by the Patch 8 keyboard HotBar/inventory so Count and item chrome stay native. -->
        <Grid Width="104" Height="104" Background="Transparent">
            <Rectangle x:Name="GenericIcon"
                       Fill="{Binding Content.Icon}"
                       Width="104"
                       Height="104"/>
            <ContentPresenter x:Name="ItemPresenter"
                              Content="{Binding Content}"
                              ContentTemplate="{StaticResource Template.Item}"
                              Width="104"
                              Height="104"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="Collapsed"/>
            <Rectangle x:Name="DisabledOverlay"
                       Width="104"
                       Height="104"
                       Fill="#88000000"
                       Visibility="Collapsed"/>
            <Image x:Name="SubSelectIndicator"
                   Source="{StaticResource IcoPlusImg}"
                   Stretch="None"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,8,8,0"
                   Visibility="Collapsed"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding SlotType}" Value="Item">
                <Setter TargetName="GenericIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ItemPresenter" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.IsEquipment}" Value="True">
                <Setter TargetName="ItemPresenter" Property="ContentTemplate" Value="{StaticResource Template.ItemEquipment}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.IsContainer}" Value="True">
                <Setter TargetName="ItemPresenter" Property="ContentTemplate" Value="{StaticResource Template.ItemContainer}"/>
                <Setter TargetName="SubSelectIndicator" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CanUse}" Value="False">
                <Setter TargetName="DisabledOverlay" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="CAM_ActionGridPanel">
        <ls:LSGrid ActionUpEvent="UIUp"
                   ActionDownEvent="UIDown"
                   ActionRightEvent="UIRight"
                   ActionLeftEvent="UILeft"
                   AutoIndex="True"
                   ContainerData="{Binding}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   CellWidth="{StaticResource CAM_ActionGridCellSize}"
                   CellHeight="{StaticResource CAM_ActionGridCellSize}"
                   EmptyCellTemplate="{DynamicResource EmptyCellTemplate}">
            <ls:LSGrid.Columns>
                <MultiBinding Converter="{StaticResource DivideMultiConverter}" ConverterParameter="Floor">
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type ScrollContentPresenter}}"/>
                    <Binding Source="{StaticResource CAM_ActionGridCellSize}"/>
                </MultiBinding>
            </ls:LSGrid.Columns>
        </ls:LSGrid>
    </ItemsPanelTemplate>

    <!-- Native radial assignment proves one outer LSListBox can own LocalFocus across
         nested LSListBox groups. CAM uses the same shape for the KeyboardHotBars fallback,
         but every executable child remains a VMHotBarSlot from VMHotBar.SlotList. -->
    <ItemsPanelTemplate x:Key="CAM_AllGroupsPanel">
        <ls:LSVirtualizingStackPanel/>
    </ItemsPanelTemplate>

    <Style x:Key="CAM_AllGroupContainerStyle"
           TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ls:MoveFocus.Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter HorizontalAlignment="Stretch"
                                      VerticalAlignment="Top"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SlotList.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CAM_AllGroupTemplate"
                  DataType="ls:VMHotBar">
        <ls:LSListBox x:Name="CAM_AllGroupSlots"
                      ItemsSource="{Binding SlotList}"
                      Focusable="False"
                      ActionNextEvent="UIDown"
                      ActionPrevEvent="UIUp"
                      KeyboardNavigation.DirectionalNavigation="Continue"
                      HorizontalAlignment="Stretch"
                      Template="{StaticResource ScrolllessListBox}"
                      ItemContainerStyle="{StaticResource CAM_ActionGridSlotContainer}"
                      ItemTemplate="{StaticResource CAM_ActionGridSlotTemplate}"
                      ItemsPanel="{StaticResource CAM_ActionGridPanel}">
            <b:Interaction.Triggers>
                <!-- The outer group selection is the native radial-style handoff boundary.
                     Arm the existing concrete-slot focus token on the selected inner list,
                     then select its first VMHotBarSlot. -->
                <b:PropertyChangedTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                       Operator="Equal"
                                                       RightOperand="True"/>
                                <b:ComparisonCondition LeftOperand="{Binding SlotList.Count}"
                                                       Operator="GreaterThan"
                                                       RightOperand="0"/>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_AllModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="Tag"
                                            Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="SelectedIndex"
                                            Value="-1"/>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="SelectedIndex"
                                            Value="0"/>
                </b:PropertyChangedTrigger>
                <b:EventTrigger EventName="Loaded">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                       Operator="Equal"
                                                       RightOperand="True"/>
                                <b:ComparisonCondition LeftOperand="{Binding SlotList.Count}"
                                                       Operator="GreaterThan"
                                                       RightOperand="0"/>
                                <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=CAM_ProviderModeMarker}"
                                                       Operator="Equal"
                                                       RightOperand="{StaticResource CAM_AllModeToken}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="Tag"
                                            Value="{StaticResource CAM_ResetFirstFocusToken}"/>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="SelectedIndex"
                                            Value="-1"/>
                    <b:ChangePropertyAction TargetName="CAM_AllGroupSlots"
                                            PropertyName="SelectedIndex"
                                            Value="0"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </ls:LSListBox>
    </DataTemplate>

    <!-- Controller selection is transport only. Native resource content is the current Patch 8
         ActionResourcesList item template; ListBoxItem.IsSelected must not alter its visuals. -->
    <Style x:Key="CAM_ResourceTabItemStyle"
           TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="-4,0,-4,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <b:Interaction.Triggers>
                            <b:DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True">
                                <b:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type ls:LSListBox}}}"
                                                        PropertyName="Tag"
                                                        Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                            </b:DataTrigger>
                        </b:Interaction.Triggers>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActionResource}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActionResource.MaxValue}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CAM_ResourceTabTemplate"
                  DataType="ls:VMActionResourceCostPreview">
        <ls:LSButton Padding="0"
                     Margin="4,-10,4,10"
                     Focusable="False"
                     ls:MoveFocus.Focusable="False">
            <ls:AttachedProperties.AutomationId>
                <MultiBinding StringFormat="{}{0}_{1}">
                    <Binding Path="ActionResource.TypeId"/>
                    <Binding Path="ActionResource.Value"/>
                </MultiBinding>
            </ls:AttachedProperties.AutomationId>

            <Grid x:Name="Root" Width="72">
                <Image x:Name="BgBg" Source="{StaticResource CAM_BoxResourceBg}"/>
                <Image x:Name="Bg"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Source="{StaticResource CAM_BoxResource}"
                       Margin="{StaticResource CAM_ResourceBackgroundMargin}"/>
                <Image x:Name="BgHL"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Source="{StaticResource CAM_BoxResourceH}"
                       Margin="{StaticResource CAM_ResourceBackgroundMargin}"/>
                <Image x:Name="BgDisabled"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Source="{StaticResource CAM_BoxResourceDisabled}"
                       Margin="{StaticResource CAM_ResourceBackgroundMargin}"/>

                <Border Background="Transparent"
                        Width="72"
                        Height="72"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ToolTipService.IsEnabled="True"
                        ToolTipService.Placement="Top">
                    <Border.ToolTip>
                        <ls:LSTooltip IsHitTestVisible="False"
                                      Style="{StaticResource ManagedTooltipStyle}"
                                      Content="{Binding ElementName=Root, Path=DataContext}"/>
                    </Border.ToolTip>
                    <ls:LSActionPointResources x:Name="ResourcePoints"
                                               Background="Transparent"
                                               HorizontalAlignment="Center"
                                               MaxActionPoints="{Binding MaxValue}"
                                               AvailableActionPoints="{Binding Value}"
                                               HighlightedActionPoints="{Binding DataContext.Cost, ElementName=Root}"
                                               DataContext="{Binding ActionResource}"
                                               MaxActionPointGroups="0"
                                               SmallActionPointSize="24"
                                               ActionPointGroupSize="56"
                                               Style="{StaticResource ActionResourcesTemplateSelector}"/>
                </Border>

                <Image x:Name="SpellSlotLevels"
                       Stretch="None"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Margin="0,-10,0,0"
                       IsHitTestVisible="False"
                       Style="{StaticResource RomanNumeralLevelImage}"
                       Visibility="Hidden"
                       DataContext="{Binding ActionResource}"/>

                <TextBlock x:Name="ResourcesNumeralDisplay"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,20,0,-20"
                           Foreground="{Binding Foreground, ElementName=ResourcePoints}"
                           IsHitTestVisible="False"
                           FontWeight="Bold"
                           FontSize="{DynamicResource MediumFontSize}"
                           Text="{Binding ActionResource.Value}"
                           noesis:Text.Stroke="{StaticResource LS_PrimaryColorOutlineColor}"
                           noesis:Text.StrokeThickness="4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden"/>
                            <Style.Triggers>
                                <DataTrigger Value="False">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource LessThanOrEqualMultiConverter}">
                                            <Binding Path="ActionResource.Value"/>
                                            <Binding ElementName="ResourcePoints" Path="MaxGroupActionPoints"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ls:LSButton>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Path=Tag, ElementName=Root}" Value="SpellSlot">
                <Setter TargetName="BgBg" Property="Source" Value="{StaticResource CAM_BoxResourceNumBg}"/>
                <Setter TargetName="Bg" Property="Source" Value="{StaticResource CAM_BoxResourceNum}"/>
                <Setter TargetName="BgHL" Property="Source" Value="{StaticResource CAM_BoxResourceNumH}"/>
                <Setter TargetName="BgDisabled" Property="Source" Value="{StaticResource CAM_BoxResourceNumDisabled}"/>
                <Setter TargetName="BgBg" Property="Margin" Value="0,-8,0,0"/>
                <Setter TargetName="Bg" Property="Margin" Value="0,-8,0,0"/>
                <Setter TargetName="BgHL" Property="Margin" Value="0,-8,0,0"/>
                <Setter TargetName="BgDisabled" Property="Margin" Value="0,-8,0,0"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActionResource.TypeId}" Value="SpellSlot">
                <Setter TargetName="SpellSlotLevels" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Root" Property="Tag" Value="SpellSlot"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActionResource.TypeId}" Value="WarlockSpellSlot">
                <Setter TargetName="SpellSlotLevels" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Root" Property="Tag" Value="SpellSlot"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="BgHL" Property="Visibility" Value="Visible"/>
                <Setter TargetName="BgDisabled" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <!-- Controller adaptation of the exact native HotBar hover chrome.
                 LB/RB selects a resource ListBoxItem rather than moving the mouse.
                 When a special provider is active the remembered resource item
                 must NOT stay highlighted. The zero-resource disabled trigger below
                 retains precedence over controller selection. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True"/>
                    <Condition Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{x:Null}"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bg" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="BgHL" Property="Visibility" Value="Visible"/>
                <Setter TargetName="BgDisabled" Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding ActionResource.Value}" Value="0">
                <Setter TargetName="Bg" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="BgHL" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="BgDisabled" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActionResource.TypeId}" Value="ActionPoint">
                <Setter Property="ls:TutorialProperties.ModalType" Value="Bottom"/>
                <Setter Property="ls:TutorialProperties.TargetStep" Value="2"/>
                <Setter Property="ls:TutorialProperties.TargetID" Value="TUT_Combat"/>
                <Setter Property="ls:TutorialProperties.Padding" Value="6,18,6,0"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActionResource.TypeId}" Value="BonusActionPoint">
                <Setter Property="ls:TutorialProperties.ModalType" Value="Bottom"/>
                <Setter Property="ls:TutorialProperties.TargetStep" Value="3"/>
                <Setter Property="ls:TutorialProperties.TargetID" Value="TUT_Combat"/>
                <Setter Property="ls:TutorialProperties.Padding" Value="6,18,6,0"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ActionResource.TypeId}" Value="BardicInspiration">
                <Setter TargetName="ResourcesNumeralDisplay" Property="Margin" Value="0,22,0,-22"/>
                <Setter TargetName="ResourcesNumeralDisplay" Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="CAM_ResourceTabsPanel">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"/>
    </ItemsPanelTemplate>

    <ControlTemplate x:Key="ActionRadialWidgetTemplate_P8">
        <Grid>
            <Control x:Name="CAM_NestedReturnMarker"
                     Visibility="Collapsed"
                     IsEnabled="False"
                     Focusable="False"
                     Tag="{x:Null}"/>
            <Control x:Name="CAM_TabCycleMarker"
                     Visibility="Collapsed"
                     IsEnabled="False"
                     Focusable="False"
                     Tag="{x:Null}"/>
            <Control x:Name="CAM_ProviderModeMarker"
                     Visibility="Collapsed"
                     IsEnabled="False"
                     Focusable="False"
                     Tag="{x:Null}"/>
            <ls:LSButton x:Name="CAM_ProviderRestoreCommand"
                         Visibility="Collapsed"
                         IsEnabled="False"
                         Focusable="False"
                         IsHitTestVisible="False"
                         Width="0"
                         Height="0">
                <ls:LSButton.Style>
                    <Style TargetType="{x:Type ls:LSButton}">
                        <Setter Property="Command" Value="{Binding FilterActionResourceCommand}"/>
                        <Setter Property="CommandParameter" Value="{Binding SelectedItem, ElementName=CAM_ResourceTabs}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_CantripsModeToken}">
                                <Setter Property="Command" Value="{Binding FilterCantripsCommand}"/>
                                <Setter Property="CommandParameter" Value="{StaticResource CAM_CantripFilterParameter}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_ItemsModeToken}">
                                <Setter Property="Command" Value="{x:Null}"/>
                                <Setter Property="CommandParameter" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_AllModeToken}">
                                <Setter Property="Command" Value="{x:Null}"/>
                                <Setter Property="CommandParameter" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_MetamagicModeToken}">
                                <Setter Property="Command" Value="{x:Null}"/>
                                <Setter Property="CommandParameter" Value="{x:Null}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, ElementName=CAM_ProviderModeMarker}" Value="{StaticResource CAM_PassivesModeToken}">
                                <Setter Property="Command" Value="{x:Null}"/>
                                <Setter Property="CommandParameter" Value="{x:Null}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ls:LSButton.Style>
            </ls:LSButton>
            <b:Interaction.Triggers>
                <b:DataTrigger Binding="{Binding IsShowingAContainerWithVariants}" Value="True">
                    <b:ChangePropertyAction TargetName="CAM_NestedReturnMarker"
                                            PropertyName="Tag"
                                            Value="{StaticResource CAM_NestedEnteredToken}"/>
                    <ls:SetMoveFocusAction TargetName="ActionRadials" FocusElement="{Binding ElementName=HotBarList}" DeferFocusAction="True"/>
                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding IsSelectingUpcastedSpell}" Value="True">
                    <b:ChangePropertyAction TargetName="CAM_NestedReturnMarker"
                                            PropertyName="Tag"
                                            Value="{StaticResource CAM_NestedEnteredToken}"/>
