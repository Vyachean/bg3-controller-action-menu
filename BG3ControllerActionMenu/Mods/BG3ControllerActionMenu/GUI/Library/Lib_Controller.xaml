                            <TextBlock Text="{Binding Source='haf48b625gb2f0g449egb3aegfddfa1be81c2', Converter={StaticResource TranslatedStringConverter}}" FontSize="24"/>
                        </ls:LSListBoxItem>
                        <ls:LSListBoxItem x:Name="CAM_ClassFilterTab" Style="{StaticResource CAM_FilterTabItemStyle}"
                                          Visibility="{Binding CurrentPlayer.SelectedCharacter.IsShapeShifted, Converter={StaticResource BoolToCollapsedConverter}}">
