<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:ls="clr-namespace:ls;assembly=Code"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/GustavNoesisGUI;component/Library/DataTemplates.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/GustavNoesisGUI;component/Library/FocusableControls_c.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/MainUI;component/Library/Tooltips.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
      Runtime ownership:
        * BG3 owns the ActionRadials state.
        * BG3 owns MainUI/Pages/ActionRadials.xaml and its page lifecycle.
        * CAM overrides only the ActionRadialWidgetTemplate_P8 resource key.

      The inner HotBarSlotStyle button is visual-only. Controller focus belongs
      to the ListBoxItem/LSGrid hierarchy already used by Patch 8's native
      ActionRadials slot-assignment grids. Page-level UIAccept then dispatches
      ActionRadials.Tag through BG3's UseSlotCommand.
    -->

    <DataTemplate x:Key="CAM_NativeHotbarButton">
        <ls:LSButton x:Name="NativeSlotButton"
                     Style="{StaticResource HotBarSlotStyle}"
                     Content="{Binding Content}"
                     BoundEvent="UIAccept"
                     Command="{x:Null}"
                     CommandParameter="{x:Null}"
                     EatInput="False"
                     Focusable="False"
                     ls:MoveFocus.Focusable="False"
                     Margin="8"/>
    </DataTemplate>

    <Style x:Key="CAM_SlotContainer"
           TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="FocusBorder"
                            Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ls:MoveFocus.IsFocused" Value="True">
                            <Setter TargetName="FocusBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource LS_PrimaryColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SlotType}" Value="Empty">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Focusable" Value="False"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ItemsPanelTemplate x:Key="CAM_NativeGrid">
        <ls:LSGrid ActionUpEvent="UIUp"
                   ActionDownEvent="UIDown"
                   ActionLeftEvent="UILeft"
                   ActionRightEvent="UIRight"
                   AutoIndex="True"
                   Columns="8"
                   CellWidth="{StaticResource HotBarSlotWidth}"
                   CellHeight="{StaticResource HotBarSlotHeight}"
                   HorizontalSpacing="16"
                   VerticalSpacing="16"
                   DisableScrolling="True"/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="CAM_HotBarSectionTemplate">
        <StackPanel x:Name="SectionRoot" Margin="0,0,0,26">
            <TextBlock x:Name="SectionTitle"
                       Text="{Binding HotBarType}"
                       Foreground="{DynamicResource LS_PrimaryColor}"
                       FontSize="{DynamicResource DefaultFontSize}"
                       FontWeight="DemiBold"
                       Margin="8,0,8,10"/>
            <Border BorderThickness="2"
                    Padding="8"
                    BorderBrush="{StaticResource LS_InventoryGridSurround}">
                <ls:LSListBox x:Name="SectionSlots"
                              ItemsSource="{Binding SlotList}"
                              Focusable="False"
                              Template="{StaticResource ScrolllessListBox}"
                              ItemContainerStyle="{StaticResource CAM_SlotContainer}"
                              ItemTemplate="{StaticResource CAM_NativeHotbarButton}"
                              ItemsPanel="{StaticResource CAM_NativeGrid}"
                              KeyboardNavigation.DirectionalNavigation="Continue">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="LocalFocusChanged">
                            <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                            <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                   CommandParameter="{x:Null}"/>
                            <b:InvokeCommandAction Command="{Binding DataContext.HighlightResourcesCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                   CommandParameter="{x:Null}"/>
                            <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_SlotHover"/>
                        </b:EventTrigger>
                        <b:TimerTrigger EventName="LocalFocusChanged" MillisecondsPerTick="70" TotalTicks="1">
                            <b:ChangePropertyAction TargetName="ActionRadials"
                                                    PropertyName="Tag"
                                                    Value="{Binding LocalFocus.DataContext, ElementName=SectionSlots}"/>
                            <b:ChangePropertyAction TargetName="HotBarList"
                                                    PropertyName="Tag"
                                                    Value="{Binding FocusedElement, ElementName=ActionRadials}"/>
                            <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                   CommandParameter="{Binding LocalFocus.DataContext, ElementName=SectionSlots}"/>
                            <b:InvokeCommandAction Command="{Binding DataContext.HighlightResourcesCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                   CommandParameter="{Binding LocalFocus.DataContext, ElementName=SectionSlots}"/>
                        </b:TimerTrigger>
                    </b:Interaction.Triggers>
                </ls:LSListBox>
            </Border>
        </StackPanel>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HotBarType}" Value="CommonHotBar">
                <Setter TargetName="SectionTitle" Property="Text" Value="Actions"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HotBarType}" Value="ClassHotBar">
                <Setter TargetName="SectionTitle" Property="Text" Value="Class"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HotBarType}" Value="ItemHotBar">
                <Setter TargetName="SectionTitle" Property="Text" Value="Items"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HotBarType}" Value="PassivesHotBar">
                <Setter TargetName="SectionRoot" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HotBarType}" Value="FixedSideBar">
                <Setter TargetName="SectionRoot" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Same resource key consumed by the unmodified native ActionRadials.xaml. -->
    <ControlTemplate x:Key="ActionRadialWidgetTemplate_P8">
        <Grid x:Name="CAM_Root" Background="Transparent">
            <!-- Preserve native close behavior for split-screen ownership changes. -->
            <b:Interaction.Triggers>
                <b:DataTrigger Binding="{Binding Layout}" Value="Common">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding Data.IsFullScreenSharedInitiativeEnabled}" Operator="Equal" RightOperand="False"/>
                                <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.IsCurrentTurn}" Operator="Equal" RightOperand="False"/>
                                <b:ComparisonCondition LeftOperand="{Binding Data.LocalPlayers.Count}" Operator="Equal" RightOperand="2"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:InvokeCommandAction Command="{Binding CustomEvent}" CommandParameter="CloseRadials"/>
                </b:DataTrigger>
                <b:DataTrigger Binding="{Binding Layout}" Value="Common">
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding Data.IsFullScreenSharedInitiativeEnabled}" Operator="Equal" RightOperand="True"/>
                                <b:ComparisonCondition LeftOperand="{Binding CurrentPlayer.SelectedCharacter.IsOwnerActiveInSplitscreenFullscreenTurn}" Operator="Equal" RightOperand="False"/>
                                <b:ComparisonCondition LeftOperand="{Binding Data.LocalPlayers.Count}" Operator="Equal" RightOperand="2"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:InvokeCommandAction Command="{Binding CustomEvent}" CommandParameter="CloseRadials"/>
                </b:DataTrigger>
            </b:Interaction.Triggers>

            <Border x:Name="CAM_DiagnosticPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,28,28,0"
                    Padding="14"
                    Background="#D9151820"
                    BorderBrush="{StaticResource LS_InventoryGridSurround}"
                    BorderThickness="2"
                    Panel.ZIndex="20">
                <StackPanel Width="380">
                    <TextBlock Text="CAM 0.0.23-native-page-library-override Xbox diagnostic"
                               Foreground="{DynamicResource LS_PrimaryColor}"
                               FontWeight="DemiBold"
                               FontSize="{DynamicResource SmallFontSize}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="native ActionRadials page + Lib_Controller template override"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource LS_InfoColor1}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Controller bars: " Foreground="{DynamicResource LS_InfoColor1}"/>
                        <TextBlock Text="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.ControllerHotBars.Count}" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nested slots: " Foreground="{DynamicResource LS_InfoColor1}"/>
                        <TextBlock Text="{Binding SingleHotBar.SlotList.Count}" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Radials flag: " Foreground="{DynamicResource LS_InfoColor1}"/>
                        <TextBlock Text="{Binding CurrentPlayer.UIData.AreRadialsOpen}" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Focus: " Foreground="{DynamicResource LS_InfoColor1}"/>
                        <TextBlock Text="{Binding Path=FocusedElement.Name, ElementName=ActionRadials, FallbackValue='none'}" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Focused slot: " Foreground="{DynamicResource LS_InfoColor1}"/>
                        <TextBlock Text="{Binding Path=Tag.SlotType, ElementName=ActionRadials, FallbackValue='none'}" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Width="1160"
                  MaxHeight="1840"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#E6111318">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="PanelTitle"
                           Grid.Row="0"
                           Text="Actions"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,18"
                           FontSize="{DynamicResource LargeFontSize}"
                           FontWeight="DemiBold"
                           Foreground="{DynamicResource LS_PrimaryColor}"/>

                <Grid Grid.Row="1">
                    <ls:LSScrollViewer x:Name="MainHotbarListHolder"
                                       Margin="36,0"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Disabled"
                                       ScrollToElement="{Binding FocusedElement, ElementName=ActionRadials}"
                                       ls:ScrollViewerHelper.VerticalScrollOffsetMargin="220">
                        <ItemsControl x:Name="HotBarList"
                                      ItemsSource="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.ControllerHotBars}"
                                      ItemTemplate="{StaticResource CAM_HotBarSectionTemplate}"
                                      KeyboardNavigation.DirectionalNavigation="Continue"/>
                    </ls:LSScrollViewer>

                    <ls:LSScrollViewer x:Name="VariantScrollViewer"
                                       Visibility="Collapsed"
                                       Margin="36,0"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Disabled"
                                       ScrollToElement="{Binding FocusedElement, ElementName=ActionRadials}"
                                       ls:ScrollViewerHelper.VerticalScrollOffsetMargin="220">
                        <ls:LSListBox x:Name="VariantList"
                                      ItemsSource="{Binding SingleHotBar.SlotList}"
                                      ItemContainerStyle="{StaticResource CAM_SlotContainer}"
                                      ItemTemplate="{StaticResource CAM_NativeHotbarButton}"
                                      ItemsPanel="{StaticResource CAM_NativeGrid}"
                                      Template="{StaticResource ScrolllessListBox}"
                                      Focusable="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      KeyboardNavigation.DirectionalNavigation="Continue">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="LocalFocusChanged">
                                    <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.HighlightResourcesCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{x:Null}"/>
                                    <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_SlotHover"/>
                                </b:EventTrigger>
                                <b:TimerTrigger EventName="LocalFocusChanged" MillisecondsPerTick="70" TotalTicks="1">
                                    <b:ChangePropertyAction TargetName="ActionRadials"
                                                            PropertyName="Tag"
                                                            Value="{Binding LocalFocus.DataContext, ElementName=VariantList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=VariantList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.HighlightResourcesCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=VariantList}"/>
                                </b:TimerTrigger>
                            </b:Interaction.Triggers>
                        </ls:LSListBox>
                    </ls:LSScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,24">
                    <ls:LSButton x:Name="UseHint"
                                 IsHitTestVisible="False"
                                 ContentTemplate="{StaticResource ControllerButtonHint}"
                                 Content="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='UIAccept'}"
                                 Margin="12,0"/>

                    <!-- Captured Patch 8 radial B seam. -->
                    <ls:LSButton x:Name="CancelButton"
                                 BoundEvent="UICancel"
                                 Command="{Binding ClearSingleHotbarCommand}"
                                 Tag="{Binding Source='h01d5c470g61bfg498cgb17eg7be425444fa5', Converter={StaticResource TranslatedStringConverter}}"
                                 ContentTemplate="{StaticResource ControllerButtonHint}"
                                 Content="{Binding CurrentPlayer.UIData.InputEvents, ConverterParameter=UICancel, Converter={StaticResource FindInputEventConverter}}"
                                 HorizontalContentAlignment="Left"
                                 HorizontalAlignment="Left"
                                 Width="1000">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="LSButtonReleased">
                                <b:InvokeCommandAction Command="{Binding ActionCancelCommand}"/>
                                <ls:SetMoveFocusAction TargetName="ActionRadials"
                                                       FocusElement="{Binding ElementName=HotBarList, Path=Tag}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ls:LSButton>
                </StackPanel>

                <!-- Captured Patch 8 normal A dispatch. -->
                <ls:LSButton x:Name="UseSlotBinding"
                             Command="{Binding UseSlotCommand}"
                             CommandParameter="{Binding Tag, ElementName=ActionRadials}"
                             Height="0"
                             BoundEvent="UIAccept"
                             HorizontalAlignment="Left"/>
            </Grid>

            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding SingleHotBar.SlotList.Count, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}"
                             Value="True">
                    <Setter TargetName="MainHotbarListHolder" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="VariantScrollViewer" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="PanelTitle" Property="Text" Value="Select"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsShowingItemsToThrow}" Value="True">
                    <Setter TargetName="MainHotbarListHolder" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="VariantScrollViewer" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsShowingAContainerWithVariants}" Value="True">
                    <Setter TargetName="PanelTitle"
                            Property="Text"
                            Value="{Binding Source='h79b6dc4egf450g4037gad34g8bfd57289b9a', Converter={StaticResource TranslatedStringConverter}}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsSelectingUpcastedSpell}" Value="True">
                    <Setter TargetName="PanelTitle"
                            Property="Text"
                            Value="{Binding Source='hcc0de24fgee83g49cdgb15fg2fa9b96203c9', Converter={StaticResource TranslatedStringConverter}}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Path=Tag.SlotType, ElementName=ActionRadials, FallbackValue='Empty'}"
                             Value="Empty">
                    <Setter TargetName="UseSlotBinding" Property="IsEnabled" Value="False"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Path=Tag.CanUse, ElementName=ActionRadials}" Value="False">
                    <Setter TargetName="UseSlotBinding"
                            Property="IsEnabled"
                            Value="{Binding Tag.Content.IsContainer, ElementName=ActionRadials, FallbackValue=False}"/>
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag.Content.SpellModifier, ElementName=ActionRadials, Converter={StaticResource NullToBoolFalseConverter}}" Value="True"/>
                        <Condition Binding="{Binding CurrentSingleHotbarFilter, Converter={StaticResource NullToBoolTrueConverter}, ConverterParameter='EmptyString'}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="UseSlotBinding" Property="IsEnabled" Value="True"/>
                </MultiDataTrigger>

                <!-- Captured Patch 8 main-vs-nested B switch. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SingleHotBar.SlotList.Count}" Value="0"/>
                        <Condition Binding="{Binding IsShowingItemsToThrow}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                    <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                </MultiDataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.IsShapeShifted}" Value="True">
                    <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                    <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.CharacterType}" Value="Summon">
                    <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                    <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.CharacterType}" Value="Follower">
                    <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                    <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding InSwapSlotState}" Value="True">
                    <Setter TargetName="CancelButton" Property="Command" Value="{Binding UseSlotCommand}"/>
                    <Setter TargetName="CancelButton" Property="CommandParameter" Value="{x:Null}"/>
                    <Setter TargetName="UseSlotBinding" Property="Command" Value="{x:Null}"/>
                    <Setter TargetName="UseSlotBinding" Property="EatInput" Value="False"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
