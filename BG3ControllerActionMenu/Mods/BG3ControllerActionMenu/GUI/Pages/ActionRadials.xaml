<ls:UIWidget x:Name="ActionRadials"
             ls:UIWidget.ContextName="HotBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ls="clr-namespace:ls;assembly=Code"
             xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="2160"
             d:DesignWidth="3840"
             FocusLeft="UITabPrev"
             FocusRight="UITabNext"
             ls:TooltipExtender.Owner="{Binding CurrentPlayer.SelectedCharacter}"
             KeyboardNavigation.DirectionalNavigation="Continue"
             d:DataContext="{d:DesignInstance {x:Type ls:DCHotBar}, IsDesignTimeCreatable=True}"
             CanCacheFocusSurroundingElements="True"
             Template="{StaticResource CAM_ActionRadialWidgetTemplate}"
             ls:AttachedProperties.AutomationId="{Binding (ls.UICanvas.CanvasLayout), RelativeSource={RelativeSource Mode=Self}, StringFormat='{}ActionRadials_{0}'}">

    <!-- Keep the installed Patch 8 ActionRadials page lifecycle intact. -->
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="GotKeyboardFocus">
            <b:ChangePropertyAction TargetName="ActionRadials"
                                    PropertyName="Tag"
                                    Value="{Binding Path=FocusedElement, ElementName=ActionRadials}"/>
            <b:InvokeCommandAction Command="{Binding ShowTooltipOnUIElementCommand, ElementName=ActionRadials}"
                                   CommandParameter="{Binding Path=FocusedElement, ElementName=ActionRadials}"/>
            <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
        </b:EventTrigger>

        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding EnableTooltipOnUIElementCommand, ElementName=ActionRadials}"/>
            <b:ChangePropertyAction TargetObject="{Binding CurrentPlayer.UIData}"
                                    PropertyName="AreRadialsOpen"
                                    Value="True"/>
            <b:InvokeCommandAction Command="{Binding TutorialEvent}"
                                   CommandParameter="f651618e-d396-4d4a-ba5a-8f50c3697708"/>
            <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_Open"/>
        </b:EventTrigger>

        <b:EventTrigger EventName="Loaded">
            <b:Interaction.Behaviors>
                <b:ConditionBehavior>
                    <b:ConditionalExpression>
                        <b:ComparisonCondition LeftOperand="{Binding Metadata, ElementName=ActionRadials}"
                                               Operator="Equal"
                                               RightOperand="CallAllies"/>
                    </b:ConditionalExpression>
                </b:ConditionBehavior>
            </b:Interaction.Behaviors>
            <b:InvokeCommandAction Command="{Binding CallAllies}"/>
        </b:EventTrigger>

        <b:EventTrigger EventName="Loaded">
            <b:Interaction.Behaviors>
                <b:ConditionBehavior>
                    <b:ConditionalExpression>
                        <b:ComparisonCondition LeftOperand="{Binding Metadata, ElementName=ActionRadials}"
                                               Operator="NotEqual"
                                               RightOperand="MoveToEnd"/>
                    </b:ConditionalExpression>
                </b:ConditionBehavior>
            </b:Interaction.Behaviors>
            <ls:SetMoveFocusAction TargetName="ActionRadials"
                                   DirectionFocus="Left"
                                   JumpFocus="First"/>
        </b:EventTrigger>

        <b:EventTrigger EventName="Loaded">
            <b:Interaction.Behaviors>
                <b:ConditionBehavior>
                    <b:ConditionalExpression>
                        <b:ComparisonCondition LeftOperand="{Binding Metadata, ElementName=ActionRadials}"
                                               Operator="Equal"
                                               RightOperand="MoveToEnd"/>
                    </b:ConditionalExpression>
                </b:ConditionBehavior>
            </b:Interaction.Behaviors>
            <ls:SetMoveFocusAction TargetName="ActionRadials"
                                   DirectionFocus="Right"
                                   JumpFocus="Last"/>
        </b:EventTrigger>

        <b:EventTrigger EventName="Unloaded">
            <b:ChangePropertyAction TargetName="ActionRadials" PropertyName="Tag" Value="{x:Null}"/>
        </b:EventTrigger>

        <b:EventTrigger EventName="WidgetClosing">
            <b:InvokeCommandAction Command="{Binding ClearResourceHighlightsCommand}"/>
            <b:ChangePropertyAction TargetObject="{Binding CurrentPlayer.UIData}"
                                    PropertyName="AreRadialsOpen"
                                    Value="False"/>
            <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_Close"/>
        </b:EventTrigger>

        <b:EventTrigger EventName="MoveFocusRight">
            <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_MoveRight"/>
        </b:EventTrigger>
        <b:EventTrigger EventName="MoveFocusLeft">
            <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_MoveLeft"/>
        </b:EventTrigger>

        <b:PropertyChangedTrigger Binding="{Binding Layout}">
            <b:Interaction.Behaviors>
                <b:ConditionBehavior>
                    <b:ConditionalExpression>
                        <b:ComparisonCondition LeftOperand="{Binding Tag, ElementName=ActionRadials}"
                                               Operator="NotEqual"
                                               RightOperand="{x:Null}"/>
                    </b:ConditionalExpression>
                </b:ConditionBehavior>
            </b:Interaction.Behaviors>
            <ls:SetMoveFocusAction TargetName="ActionRadials" Reset="True"/>
            <ls:SetMoveFocusAction TargetName="ActionRadials"
                                   FocusElement="{Binding Tag, ElementName=ActionRadials}"
                                   DeferFocusAction="True"/>
        </b:PropertyChangedTrigger>
    </b:Interaction.Triggers>

    <ls:UIWidget.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GustavNoesisGUI;component/Library/DataTemplates.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/GustavNoesisGUI;component/Library/FocusableControls_c.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MainUI;component/Library/Tooltips.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Current Patch 8 slot-assignment grid pattern:
                 focusable ListBoxItem -> LSGrid with ContainerData. -->
            <DataTemplate x:Key="CAM_NativeHotbarButton">
                <ls:LSButton Style="{StaticResource HotBarSlotStyle}"
                             Content="{Binding Content}"
                             BoundEvent="UIAccept"
                             Command="{x:Null}"
                             CommandParameter="{x:Null}"
                             EatInput="False"
                             Focusable="False"
                             ls:MoveFocus.Focusable="False"
                             Margin="8"/>
            </DataTemplate>

            <Style x:Key="CAM_SlotContainer"
                   TargetType="{x:Type ListBoxItem}"
                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="FocusBorder"
                                    Padding="2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="2">
                                <ContentPresenter ContentTemplate="{StaticResource CAM_NativeHotbarButton}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ls:MoveFocus.IsFocused" Value="True">
                                    <Setter TargetName="FocusBorder"
                                            Property="BorderBrush"
                                            Value="{DynamicResource LS_PrimaryColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SlotType}" Value="Empty">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Focusable" Value="False"/>
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <ItemsPanelTemplate x:Key="CAM_NativeGrid">
                <ls:LSGrid ActionUpEvent="UIUp"
                           ActionDownEvent="UIDown"
                           ActionRightEvent="UIRight"
                           ActionLeftEvent="UILeft"
                           AutoIndex="True"
                           ContainerData="{Binding}"
                           Columns="8"
                           CellWidth="120"
                           CellHeight="120"
                           HorizontalSpacing="12"
                           VerticalSpacing="12"
                           DisableScrolling="True"/>
            </ItemsPanelTemplate>

            <!-- Mirror the captured dynamic SpellGroupList pattern: each generated
                 hotbar section owns an inner LSListBox/LSGrid. -->
            <ControlTemplate x:Key="CAM_HotBarSectionTemplate"
                             TargetType="{x:Type ListBoxItem}">
                <StackPanel x:Name="SectionRoot" Margin="0,0,0,24">
                    <TextBlock x:Name="SectionTitle"
                               Text="{Binding HotBarType}"
                               Foreground="{DynamicResource LS_PrimaryColor}"
                               FontSize="{DynamicResource DefaultFontSize}"
                               FontWeight="DemiBold"
                               Margin="8,0,8,10"/>
                    <Border BorderThickness="2"
                            Padding="8"
                            BorderBrush="{StaticResource LS_InventoryGridSurround}">
                        <ls:LSListBox x:Name="SlotList"
                                      ItemsSource="{Binding SlotList}"
                                      Focusable="False"
                                      Template="{StaticResource ScrolllessListBox}"
                                      ItemContainerStyle="{StaticResource CAM_SlotContainer}"
                                      ItemsPanel="{StaticResource CAM_NativeGrid}"
                                      KeyboardNavigation.DirectionalNavigation="Continue">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="LocalFocusChanged">
                                    <b:ChangePropertyAction TargetName="ActionRadials"
                                                            PropertyName="Tag"
                                                            Value="{Binding LocalFocus.DataContext, ElementName=SlotList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=SlotList}"/>
                                    <b:InvokeCommandAction Command="{Binding DataContext.HighlightResourcesCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                           CommandParameter="{Binding LocalFocus.DataContext, ElementName=SlotList}"/>
                                    <ls:LSPlaySound Sound="UI_HUD_Controller_RadialMenu_SlotHover"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ls:LSListBox>
                    </Border>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding HotBarType}" Value="CommonHotBar">
                        <Setter TargetName="SectionTitle" Property="Text" Value="Actions"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HotBarType}" Value="ClassHotBar">
                        <Setter TargetName="SectionTitle" Property="Text" Value="Class"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HotBarType}" Value="ItemHotBar">
                        <Setter TargetName="SectionTitle" Property="Text" Value="Items"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="CAM_HotBarSectionContainer"
                   TargetType="{x:Type ListBoxItem}"
                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template" Value="{StaticResource CAM_HotBarSectionTemplate}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HotBarType}" Value="PassivesHotBar">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HotBarType}" Value="FixedSideBar">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <ControlTemplate x:Key="CAM_ActionRadialWidgetTemplate"
                             TargetType="{x:Type ls:UIWidget}">
                <Grid Background="Transparent">
                    <Border x:Name="CAM_DiagnosticPanel"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,28,28,0"
                            Padding="14"
                            Background="#D9151820"
                            BorderBrush="{StaticResource LS_InventoryGridSurround}"
                            BorderThickness="2"
                            Panel.ZIndex="20">
                        <StackPanel Width="360">
                            <TextBlock Text="CAM 0.0.21-native-shell-focus Xbox diagnostic"
                                       Foreground="{DynamicResource LS_PrimaryColor}"
                                       FontWeight="DemiBold"
                                       FontSize="{DynamicResource SmallFontSize}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Controller bars: " Foreground="{DynamicResource LS_InfoColor1}"/>
                                <TextBlock Text="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.ControllerHotBars.Count}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sections: " Foreground="{DynamicResource LS_InfoColor1}"/>
                                <TextBlock Text="{Binding Items.Count, ElementName=HotBarList}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="List focus: " Foreground="{DynamicResource LS_InfoColor1}"/>
                                <TextBlock Text="{Binding LocalFocus, ElementName=HotBarList, Converter={StaticResource NullToBoolFalseConverter}}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Widget focus: " Foreground="{DynamicResource LS_InfoColor1}"/>
                                <TextBlock Text="{Binding FocusedElement, ElementName=ActionRadials, Converter={StaticResource NullToBoolFalseConverter}}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Focused slot: " Foreground="{DynamicResource LS_InfoColor1}"/>
                                <TextBlock Text="{Binding Path=Tag.SlotType, ElementName=ActionRadials, FallbackValue='none'}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nested slots: " Foreground="{DynamicResource LS_InfoColor1}"/>
                                <TextBlock Text="{Binding SingleHotBar.SlotList.Count}" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Radials flag: " Foreground="{DynamicResource LS_InfoColor1}"/>
                                <TextBlock Text="{Binding CurrentPlayer.UIData.AreRadialsOpen}" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Width="1160"
                          MaxHeight="1840"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Background="#E6111318">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="PanelTitle"
                                   Grid.Row="0"
                                   Text="Actions"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,18"
                                   FontSize="{DynamicResource LargeFontSize}"
                                   FontWeight="DemiBold"
                                   Foreground="{DynamicResource LS_PrimaryColor}"/>

                        <Grid Grid.Row="1">
                            <ls:LSScrollViewer x:Name="MainHotbarListHolder"
                                               Margin="36,0"
                                               VerticalScrollBarVisibility="Auto"
                                               HorizontalScrollBarVisibility="Disabled"
                                               ScrollToElement="{Binding FocusedElement, ElementName=ActionRadials}"
                                               ls:ScrollViewerHelper.VerticalScrollOffsetMargin="220">
                                <Grid>
                                    <ls:LSListBox x:Name="HotBarList"
                                                  ItemsSource="{Binding CurrentPlayer.SelectedCharacter.PlayerCharacterProperties.ControllerHotBars}"
                                                  SelectedIndex="0"
                                                  ActionNextEvent="UIDown"
                                                  ActionPrevEvent="UIUp"
                                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                                  LocalFocusSelector="{Binding ElementName=GridSelector, Mode=OneWay}"
                                                  Template="{StaticResource ScrolllessListBox}"
                                                  ItemContainerStyle="{StaticResource CAM_HotBarSectionContainer}">
                                        <b:Interaction.Triggers>
                                            <b:EventTrigger EventName="LocalFocusChanged">
                                                <b:ChangePropertyAction TargetName="ActionRadials"
                                                                        PropertyName="Tag"
                                                                        Value="{Binding LocalFocus.DataContext, ElementName=HotBarList}"/>
                                            </b:EventTrigger>
                                        </b:Interaction.Triggers>
                                    </ls:LSListBox>
                                    <Control x:Name="GridSelector"
                                             IsHitTestVisible="False"
                                             VerticalAlignment="Top"
                                             HorizontalAlignment="Left"
                                             Template="{StaticResource SelectorTemplate}"
                                             Visibility="{Binding Visibility, ElementName=HotBarList}"/>
                                </Grid>
                            </ls:LSScrollViewer>

                            <ls:LSScrollViewer x:Name="VariantScrollViewer"
                                               Visibility="Collapsed"
                                               Margin="36,0"
                                               VerticalScrollBarVisibility="Auto"
                                               HorizontalScrollBarVisibility="Disabled"
                                               ScrollToElement="{Binding FocusedElement, ElementName=ActionRadials}"
                                               ls:ScrollViewerHelper.VerticalScrollOffsetMargin="220">
                                <ls:LSListBox x:Name="VariantList"
                                              ItemsSource="{Binding SingleHotBar.SlotList}"
                                              Focusable="False"
                                              SelectedIndex="0"
                                              Template="{StaticResource ScrolllessListBox}"
                                              ItemContainerStyle="{StaticResource CAM_SlotContainer}"
                                              ItemsPanel="{StaticResource CAM_NativeGrid}"
                                              KeyboardNavigation.DirectionalNavigation="Continue">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="LocalFocusChanged">
                                            <b:ChangePropertyAction TargetName="ActionRadials"
                                                                    PropertyName="Tag"
                                                                    Value="{Binding LocalFocus.DataContext, ElementName=VariantList}"/>
                                            <b:InvokeCommandAction Command="{Binding DataContext.CreateFocusedTooltipDataCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                                                   CommandParameter="{Binding LocalFocus.DataContext, ElementName=VariantList}"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSListBox>
                            </ls:LSScrollViewer>
                        </Grid>

                        <!-- Match the captured Patch 8 radial input primitives. -->
                        <ls:AlignableWrapPanel x:Name="ButtonHintsContainer"
                                               Grid.Row="2"
                                               Orientation="Horizontal"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,24">
                            <ls:LSButton x:Name="SelectButtonVisual"
                                         BoundEvent="UIAccept"
                                         EatInput="False"
                                         ContentTemplate="{StaticResource ControllerButtonHint}"
                                         Content="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='UIAccept'}"
                                         Tag="Select"
                                         Margin="12,0"/>

                            <ls:LSButton x:Name="UseSlotBinding"
                                         Command="{Binding UseSlotCommand}"
                                         CommandParameter="{Binding Tag, ElementName=ActionRadials}"
                                         Height="0"
                                         BoundEvent="UIAccept"
                                         HorizontalAlignment="Left"/>

                            <ls:LSButton x:Name="CancelButton"
                                         BoundEvent="UICancel"
                                         Command="{Binding ClearSingleHotbarCommand}"
                                         ContentTemplate="{StaticResource ControllerButtonHint}"
                                         Content="{Binding CurrentPlayer.UIData.InputEvents, ConverterParameter=UICancel, Converter={StaticResource FindInputEventConverter}}"
                                         Tag="Close Window"
                                         Margin="12,0">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="LSButtonReleased">
                                        <b:InvokeCommandAction Command="{Binding ActionCancelCommand}"/>
                                        <ls:SetMoveFocusAction TargetName="ActionRadials"
                                                               DirectionFocus="Left"
                                                               JumpFocus="First"
                                                               DeferFocusAction="True"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </ls:LSButton>
                        </ls:AlignableWrapPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SingleHotBar.SlotList.Count, Converter={StaticResource GreaterThanConverter}, ConverterParameter=0}"
                                     Value="True">
                            <Setter TargetName="MainHotbarListHolder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="VariantScrollViewer" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PanelTitle" Property="Text" Value="Select"/>
                            <Setter TargetName="HotBarList" Property="IsEnabled" Value="False"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsShowingAContainerWithVariants}" Value="True">
                            <Setter TargetName="PanelTitle"
                                    Property="Text"
                                    Value="{Binding Source='h79b6dc4egf450g4037gad34g8bfd57289b9a', Converter={StaticResource TranslatedStringConverter}}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsSelectingUpcastedSpell}" Value="True">
                            <Setter TargetName="PanelTitle"
                                    Property="Text"
                                    Value="{Binding Source='hcc0de24fgee83g49cdgb15fg2fa9b96203c9', Converter={StaticResource TranslatedStringConverter}}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Path=Tag.SlotType, ElementName=ActionRadials, FallbackValue='Empty'}"
                                     Value="Empty">
                            <Setter TargetName="UseSlotBinding" Property="IsEnabled" Value="False"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Path=Tag.CanUse, ElementName=ActionRadials}"
                                     Value="False">
                            <Setter TargetName="UseSlotBinding"
                                    Property="IsEnabled"
                                    Value="{Binding Tag.Content.IsContainer, ElementName=ActionRadials, FallbackValue=False}"/>
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SingleHotBar.SlotList.Count}" Value="0"/>
                                <Condition Binding="{Binding IsShowingItemsToThrow}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                            <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                        </MultiDataTrigger>

                        <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.IsShapeShifted}" Value="True">
                            <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                            <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.CharacterType}" Value="Summon">
                            <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                            <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding CurrentPlayer.SelectedCharacter.CharacterType}" Value="Follower">
                            <Setter TargetName="CancelButton" Property="Command" Value="{Binding CustomEvent}"/>
                            <Setter TargetName="CancelButton" Property="CommandParameter" Value="CloseWidget"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding InSwapSlotState}" Value="True">
                            <Setter TargetName="CancelButton" Property="Command" Value="{Binding UseSlotCommand}"/>
                            <Setter TargetName="CancelButton" Property="CommandParameter" Value="{x:Null}"/>
                            <Setter TargetName="UseSlotBinding" Property="Command" Value="{x:Null}"/>
                            <Setter TargetName="UseSlotBinding" Property="EatInput" Value="False"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </ls:UIWidget.Resources>
</ls:UIWidget>
